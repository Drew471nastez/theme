{
  "format": "storelib-repo/1",
  "theme": "Foundation",
  "kind": "storelib",
  "docs": "https://storelib.com/developers",
  "reads_back": [
    "config/settings.json",
    "config/settings_data.json",
    "config/settings_schema.json",
    "templates/*.json",
    "sections/*-group.json",
    "sections/*.storelib",
    "blocks/*.storelib",
    "assets/*",
    "locales/*"
  ],
  "reference_only": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "storelib.json",
    "sections/<type>.json"
  ],
