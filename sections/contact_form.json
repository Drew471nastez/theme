{
  "type": "contact_form",
  "name": "Contact Form",
  "description": "Customizable contact form with optional split layout and configurable fields.",
  "supports_typography_overrides": false,
  "icon": "mail",
  "category": "niche",
  "fields": [
    {
      "id": "hdr_content",
      "label": "Form Settings",
      "type": "header"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Get in Touch",
      "placeholder": "Section heading"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "text",
      "default": "We'd love to hear from you. Fill out the form and we'll respond within 24 hours.",
      "placeholder": "Section subheading"
    },
    {
      "id": "submit_button_text",
      "label": "Submit Button Text",
      "type": "text",
      "default": "Send Message",
      "placeholder": "e.g. Send Message"
    },
    {
      "id": "success_message",
      "label": "Success Message",
      "type": "text",
      "default": "Thanks! Your message has been sent. We'll be in touch soon.",
      "placeholder": "Message shown after successful submission"
    },
    {
      "id": "error_message",
      "label": "Error Message",
      "type": "text",
      "default": "Something went wrong. Please try again or email us directly.",
      "placeholder": "Message shown on error"
    },
    {
      "id": "show_subscribe_opt_in",
      "label": "Offer to join your list",
      "type": "toggle",
      "default": true,
      "info": "Adds an unticked \"Keep me updated\" box. Anyone who ticks it lands in your Subscribers. Nobody is added without ticking it."
    },
    {
      "id": "show_name",
      "label": "Show Name Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "show_company",
      "label": "Show Company Field",
      "type": "toggle",
      "default": false
    },
    {
      "id": "show_phone",
      "label": "Show Phone Field",
      "type": "toggle",
      "default": false
    },
    {
      "id": "show_subject",
      "label": "Show Subject Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "show_message",
      "label": "Show Message Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "name_placeholder",
      "label": "Name placeholder",
      "type": "text",
      "default": "Your name"
    },
    {
      "id": "email_placeholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@example.com"
    },
    {
      "id": "subject_placeholder",
      "label": "Subject placeholder",
      "type": "text",
      "default": "What it is about"
    },
    {
      "id": "message_placeholder",
      "label": "Message placeholder",
      "type": "text",
      "default": "Write your message"
    },
    {
      "id": "recipient_email",
      "label": "Recipient Email",
      "type": "text",
      "default": "",
      "placeholder": "hello@yoursite.com",
      "info": "Where messages are emailed. Empty uses your support email from Settings. Every message is also kept in Emails."
    },
    {
      "id": "subject_prefix",
      "label": "Subject Prefix",
      "type": "text",
      "default": "[Contact Form]",
      "placeholder": "e.g. [Contact Form]"
    },
    {
      "id": "hdr_style",
      "label": "Style",
      "type": "header"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "radio",
      "default": "centered",
      "options": [
        {
          "label": "Centered",
          "value": "centered"
        },
        {
          "label": "Split (form + image)",
          "value": "split"
        }
      ]
    },
    {
      "id": "split_image",
      "label": "Split Layout Image",
      "type": "image",
      "default": ""
    },
    {
      "id": "color_scheme",
      "label": "Color scheme",
      "type": "select",
      "default": "white",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Soft",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Brand",
          "value": "black"
        },
        {
          "label": "Accent",
          "value": "highlight"
        }
      ]
    },
    {
      "id": "bg_color",
      "label": "Background Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "text_color",
      "label": "Text Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "input_bg_color",
      "label": "Input Background Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "input_border_color",
      "label": "Input Border Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "button_color",
      "label": "Button Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "button_text_color",
      "label": "Button Text Color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "padding_top",
      "label": "Padding Top",
      "type": "range",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "type": "range",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "settings": {
        "heading": "Get in Touch",
        "subheading": "We'd love to hear from you. Fill out the form and we'll respond within 24 hours.",
        "submit_button_text": "Send Message",
        "success_message": "Thanks! Your message has been sent. We'll be in touch soon.",
        "error_message": "Something went wrong. Please try again or email us directly.",
        "show_name": true,
        "show_company": false,
        "show_phone": false,
        "show_subject": true,
        "show_message": true,
        "subject_prefix": "[Contact Form]",
        "layout": "centered",
        "padding_top": 80,
        "padding_bottom": 80,
        "color_scheme": "white"
      }
    }
  ]
}
