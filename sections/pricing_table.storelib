{# ===========================================================================
   Plans: what somebody can buy, side by side

   For the creator who sells the same thing more than one way: the course on
   its own or with the community, a month or a year, a class or a block of
   ten. Each plan is a block, so there are as many as the creator has, up to
   four, and the grid is sized by how many there are rather than by a
   setting that would have to be kept in step with them.

   A PLAN'S PRICE CAN BE ITS PRODUCT'S. The button picks a product; when the
   plan's own price is left empty the product's price is shown, so a price
   changed in Products is changed here too. A price typed here wins, for the
   plan that is sold as "$12 a month" rather than as the product's total.

   What a plan includes is typed one per line and drawn as a list with the
   `lines` filter: nobody has to add a block per line on a phone.
   =========================================================================== #}
<template>
<section class="s pt" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %} pt__head">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="pt__grid pt__grid--{{ blocks.size }}">{% endif %}
      <article class="plan{% if block.settings.highlight %} plan--pick{% endif %}" data-container data-block-id="{{ block.id }}">
        <div class="plan__body">
        {% if block.settings.label %}<p class="plan__label">{{ block.settings.label }}</p>{% endif %}
        <h3 class="plan__name">{{ block.settings.name }}</h3>
        {% if block.settings.price or block.settings.button_url.price %}
          <p class="plan__price">
            <span class="plan__amount">{{ block.settings.price | default: block.settings.button_url.price }}</span>
            {% if block.settings.period %}<span class="plan__period">{{ block.settings.period }}</span>{% endif %}
          </p>
        {% endif %}
        {% if block.settings.summary %}<p class="plan__summary">{{ block.settings.summary }}</p>{% endif %}
        {% for line in block.settings.features | lines %}
          {% if forloop.first %}<ul class="plan__list">{% endif %}
          <li>{{ line }}</li>
          {% if forloop.last %}</ul>{% endif %}
        {% endfor %}
        </div>
        {% if block.settings.button_text %}
          <a class="s__btn {% if block.settings.highlight %}s__btn--primary{% else %}s__btn--secondary{% endif %} plan__btn" href="{{ block.settings.button_url | default: '#' | url }}">{{ block.settings.button_text }}</a>
        {% endif %}
      </article>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="empty">Add plans in the sidebar</p>{% endif %}
    {% endfor %}

    {% if settings.note %}<p class="pt__note {% if settings.align == 'center' %}pt__note--center{% endif %}">{{ settings.note }}</p>{% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.7; }

.pt__head { margin-bottom: 40px; }

/* One plan is one column, however wide the page. Two sit side by side from
   a tablet up; three and four wait for the room to hold them, so a plan is
   never squeezed narrower than its price. */
.pt__grid { display: grid; gap: 20px; grid-template-columns: minmax(0, 440px); justify-content: center; }
@container (min-width: 700px) {
  .pt__grid { grid-template-columns: repeat(2, minmax(0, 400px)); }
  .pt__grid--1 { grid-template-columns: minmax(0, 440px); }
}
@container (min-width: 1000px) {
  .pt__grid--3 { grid-template-columns: repeat(3, minmax(0, 380px)); }
  .pt__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

.plan {
  display: flex; flex-direction: column;
  padding: 28px 24px 24px;
  border: 1px solid var(--s-border); border-radius: var(--s-radius);
}
/* The plan to pick is marked by its edge and its button, not by a badge
   floating over it: the label, when there is one, is a line of text. */
.plan--pick { border-color: var(--s-accent); box-shadow: inset 0 0 0 1px var(--s-accent); }
.plan__label { margin: 0 0 10px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--s-accent); }
.plan__name { margin: 0; font-size: 17px; font-weight: 600; color: var(--s-heading); }
.plan__price { margin: 14px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; color: var(--s-heading); }
.plan__amount {
  font-size: 36px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.plan__period { font-size: 14px; color: var(--s-para); }
.plan__summary { margin: 12px 0 0; font-size: 15px; line-height: 1.55; color: var(--s-para); }
/* A list of what is included, ruled like a receipt rather than ticked. */
.plan__list { margin: 20px 0 0; padding: 0; list-style: none; font-size: 14px; line-height: 1.5; color: var(--s-text); }
.plan__list li { padding: 10px 0; border-top: 1px solid var(--s-border); }
.plan__list li:last-child { border-bottom: 1px solid var(--s-border); }
/* The body takes the spare height, so the buttons line up across the plans
   whatever each one says above them. */
.plan__body { flex: 1 1 auto; }
.plan__btn { margin-top: 24px; }
.pt__note { margin: 28px 0 0; font-size: 14px; color: var(--s-para); }
.pt__note--center { text-align: center; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "pricing_table",
  "name": "Plans",
  "category": "products",
  "description": "The ways to buy, side by side.",
  "version": "1.0.0",
  "icon": "tag",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ways to join" },
    { "type": "textarea", "id": "subheading", "label": "Supporting line", "default": "" },
    { "type": "radio", "id": "align", "label": "Heading sits", "default": "center",
      "options": [{ "label": "Left", "value": "left" }, { "label": "Centre", "value": "center" }] },
    { "type": "textarea", "id": "note", "label": "Under the plans", "default": "", "placeholder": "Prices include tax." },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "wide",
      "options": [{ "label": "Medium", "value": "medium" }, { "label": "Wide", "value": "wide" }, { "label": "Full", "value": "full" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Plan" },
        { "type": "text", "id": "label", "label": "Label", "default": "", "info": "A few words above the name, such as Best value." },
        { "type": "text", "id": "price", "label": "Price", "default": "", "info": "Leave it empty to show the price of the product the button goes to." },
        { "type": "text", "id": "period", "label": "After the price", "default": "", "placeholder": "a month" },
        { "type": "textarea", "id": "summary", "label": "Summary", "default": "" },
        { "type": "textarea", "id": "features", "label": "What is included", "default": "", "info": "One per line." },
        { "type": "text", "id": "button_text", "label": "Button", "default": "Choose" },
        { "type": "product_picker", "id": "button_url", "label": "Button goes to", "default": "" },
        { "type": "checkbox", "id": "highlight", "label": "Make this the one to pick", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Plans",
      "blocks": [
        { "type": "plan", "settings": { "name": "The course", "price": "$149", "period": "once", "summary": "Every lesson, yours to keep.", "features": "Twelve video lessons\nA workbook to print\nWatch as often as you like", "button_text": "Get the course" } },
        { "type": "plan", "settings": { "name": "Course and community", "label": "Best value", "price": "$249", "period": "once", "summary": "The course, and somewhere to ask questions.", "features": "Everything in the course\nA live call every month\nThe members' forum", "button_text": "Join", "highlight": true } },
        { "type": "plan", "settings": { "name": "One to one", "price": "$600", "period": "for four calls", "summary": "Your own project, worked through with me.", "features": "Four calls of an hour\nWritten notes after each\nEmail between calls", "button_text": "Book a call" } }
      ]
    },
    {
      "name": "Plans, monthly or yearly",
      "settings": { "heading": "Become a member" },
      "blocks": [
        { "type": "plan", "settings": { "name": "Monthly", "price": "$12", "period": "a month", "features": "New patterns every week\nThe full archive\nCancel whenever you like", "button_text": "Join monthly" } },
        { "type": "plan", "settings": { "name": "Yearly", "label": "Two months free", "price": "$120", "period": "a year", "features": "Everything in monthly\nA printed pattern book each spring", "button_text": "Join yearly", "highlight": true } }
      ]
    }
  ]
}
</schema>
