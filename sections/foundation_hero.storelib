<template>
<section class="fw fw-hero" data-scheme="{{ settings.color_scheme }}" data-btn="{{ theme.buttons.style }}" data-btn-shape="{{ theme.buttons.shape }}" data-btn-hover="{{ theme.buttons.hover }}" data-btn-shadow="{{ theme.buttons.shadow }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.accent }};--fw-button:{{ scheme.primary_btn_bg | default: scheme.primary_button_background }};--fw-button-text:{{ scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-border:{{ scheme.primary_btn_border | default: scheme.primary_button_border }};--fw-button-hover:{{ scheme.primary_btn_hover_bg | default: scheme.primary_button_hover_background }};--fw-button-hover-text:{{ scheme.primary_btn_hover_text | default: scheme.primary_button_hover_text | default: scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-2:{{ scheme.secondary_btn_bg | default: scheme.secondary_button_background }};--fw-button-2-text:{{ scheme.secondary_btn_text | default: scheme.secondary_button_text }};--fw-button-2-border:{{ scheme.secondary_btn_border | default: scheme.secondary_button_border }};--fw-button-2-hover:{{ scheme.secondary_btn_hover_bg | default: scheme.secondary_button_hover_background }};--fw-button-2-hover-text:{{ scheme.secondary_btn_hover_text | default: scheme.secondary_button_hover_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner fw-hero__layout">
  <div class="fw-hero__copy">
   {% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}
   <h1 class="fw-hero__title">{{ settings.heading }}</h1>
   {% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}
   <div class="fw-hero__buttons">
    {% if settings.primary_label %}<a class="fw__action" data-sl-button href="{{ settings.primary_url | default: '/products' | url }}">{{ settings.primary_label }} <span aria-hidden="true">↗</span></a>{% endif %}
    {% if settings.secondary_label %}<a class="fw__action fw__action--secondary" data-sl-button href="{{ settings.secondary_url | default: '/about' | url }}">{{ settings.secondary_label }}</a>{% endif %}
   </div>
   {% if settings.small_note %}<p class="fw-hero__note">{{ settings.small_note }}</p>{% endif %}
  </div>
  <div class="fw-hero__art" aria-label="{{ settings.image_alt | default: 'Featured collection' }}">
   <div class="fw-hero__frame">
    {% if settings.hero_image %}<img src="{{ settings.hero_image | asset }}" alt="{{ settings.image_alt }}" fetchpriority="high" decoding="async">{% else %}<div class="fw-hero__placeholder" aria-hidden="true"><span class="fw-hero__shape fw-hero__shape--a"></span><span class="fw-hero__shape fw-hero__shape--b"></span><span class="fw-hero__shape fw-hero__shape--c"></span></div>{% endif %}
   </div>
   {% if settings.show_floating_card %}<a class="fw-hero__floating" href="{{ settings.card_url | default: '/products' | url }}">
    {% if settings.card_image %}<img src="{{ settings.card_image | asset }}" alt="" loading="lazy">{% else %}<span class="fw-hero__mini" aria-hidden="true"></span>{% endif %}
    <span><small>{{ settings.card_kicker }}</small><strong>{{ settings.card_heading }}</strong></span><span aria-hidden="true">↗</span>
   </a>{% endif %}
  </div>
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a:not(.fw__action){color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:calc(var(--fw-top) * var(--theme-spacing-scale,1)) var(--theme-padding-x, 24px) calc(var(--fw-bottom) * var(--theme-spacing-scale,1));margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-family:var(--sl-caption-font, var(--theme-font-accent, var(--theme-font-body))),sans-serif;font-size:var(--sl-caption-size, var(--type-caption-size, 11px));font-weight:var(--sl-caption-weight, var(--type-caption-weight, 700));letter-spacing:var(--sl-caption-tracking, var(--type-caption-tracking, .14em));text-transform:var(--sl-caption-transform, var(--type-caption-transform, uppercase));line-height:var(--type-caption-line-height, 1.4);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font, var(--type-h2-font, var(--theme-font-heading))),sans-serif;font-size:var(--section-heading-size, var(--type-h2-size, clamp(30px, 4.2cqi, 56px)));font-weight:var(--section-heading-weight, var(--type-h2-weight, 650));line-height:var(--section-heading-line-height, var(--type-h2-line-height, 1.12));letter-spacing:var(--section-heading-tracking, var(--type-h2-tracking, -.04em));text-transform:var(--section-heading-transform, var(--type-h2-transform, none));overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--section-body-font, var(--type-body-font, var(--theme-font-body))),sans-serif;font-size:var(--section-text-size, var(--type-body-size, 16px));line-height:var(--section-text-line-height, var(--type-body-line-height, 1.7));font-weight:var(--type-body-weight, 400);letter-spacing:var(--type-body-tracking, 0);color:var(--fw-muted);}
.fw a.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding, 12px 22px);text-decoration:none;border-radius:var(--theme-button-radius, var(--fw-radius));font-family:var(--type-button-font, var(--theme-font-body)),sans-serif;font-weight:var(--theme-button-weight, var(--type-button-weight, 600));font-size:var(--sl-button-size, var(--type-button-size, 15px));line-height:var(--sl-button-line-height, var(--type-button-line-height, 1.2));letter-spacing:var(--type-button-tracking, 0);text-transform:var(--type-button-transform, none);background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));border:1px solid var(--fw-button-border, var(--fw-button, var(--scheme-button-primary-border)));box-shadow:var(--sl-btn-shadow, none);transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,box-shadow 180ms ease,transform 220ms cubic-bezier(.22,1,.36,1);}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:var(--fw-button, var(--scheme-button-primary));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:transparent;box-shadow:none;}
.fw a.fw__action:hover{background:var(--fw-button-hover, var(--fw-button, var(--scheme-button-primary-hover)));color:var(--fw-button-hover-text, var(--fw-button-text, var(--scheme-button-primary-hover-text)));border-color:var(--fw-button-hover, var(--fw-button));}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary):hover{background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary):hover{background:color-mix(in srgb, var(--fw-button, var(--scheme-button-primary)) 12%, transparent);color:var(--fw-button, var(--scheme-button-primary));}
.fw a.fw__action.fw__action--secondary{background:var(--fw-button-2, var(--scheme-button-secondary, transparent));color:var(--fw-button-2-text, var(--scheme-button-secondary-text, var(--fw-title)));border-color:var(--fw-button-2-border, var(--scheme-button-secondary-border, var(--fw-line)));}
.fw a.fw__action.fw__action--secondary:hover{background:var(--fw-button-2-hover, var(--fw-button-2, var(--scheme-button-secondary-hover, transparent)));color:var(--fw-button-2-hover-text, var(--fw-button-2-text, var(--scheme-button-secondary-hover-text, var(--fw-title))));}
.fw[data-btn-shape="square"] .fw__action{border-radius:0;}
.fw[data-btn-shape="pill"] .fw__action{border-radius:999px;}
.fw[data-btn-shadow="true"][data-btn="filled"] .fw__action:not(.fw__action--secondary){box-shadow:0 8px 22px color-mix(in srgb, var(--scheme-button-primary, var(--fw-button)) 24%, transparent);}
.fw[data-btn-hover="lift"] .fw__action:hover{transform:translateY(-2px);}
.fw[data-btn-hover="scale"] .fw__action:hover{transform:scale(1.03);}
.fw[data-btn-hover="none"] .fw__action,.fw[data-btn-hover="none"] .fw__action:hover{transition:none;transform:none;}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-hero__layout{display:grid;grid-template-columns:minmax(0,.96fr) minmax(0,1.04fr);gap:clamp(36px,6vw,110px);align-items:center;min-height:570px;}
.fw-hero__copy{padding-block:40px;}.fw-hero__title{margin:0;font-family:var(--type-h1-font, var(--section-heading-font, var(--theme-font-heading))),sans-serif;font-size:var(--type-h1-size, clamp(46px, 5.8cqi, 88px));line-height:var(--type-h1-line-height, 1.04);letter-spacing:var(--type-h1-tracking, -.04em);font-weight:var(--type-h1-weight, 640);text-transform:var(--type-h1-transform, none);color:var(--fw-title);max-width:11ch;overflow-wrap:break-word;}
.fw-hero__buttons{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px;}.fw-hero__note{font-size:var(--type-caption-size, 12px);font-family:var(--type-caption-font, var(--theme-font-body)),sans-serif;color:var(--fw-muted);margin:23px 0 0;}
.fw-hero__art{position:relative;min-height:460px;padding:12px 0 24px 14px;}.fw-hero__frame{height:100%;min-height:440px;aspect-ratio:1.11;overflow:hidden;border-radius:var(--sl-image-radius, var(--fw-radius));background:var(--scheme-background-secondary, var(--fw-line));}
.fw-hero__frame>img{width:100%;height:100%;object-fit:cover;}.fw-hero__placeholder{position:relative;height:100%;min-height:440px;overflow:hidden;background:linear-gradient(135deg, var(--scheme-background-secondary, var(--fw-bg)) 0%, var(--fw-line) 100%);}
.fw-hero__shape{position:absolute;display:block;}.fw-hero__shape--a{height:56%;width:41%;background:var(--fw-accent);border-radius:140px 140px 22px 22px;transform:rotate(-24deg);left:27%;top:20%;}.fw-hero__shape--b{height:34%;width:34%;border-radius:100%;background:color-mix(in srgb, var(--fw-accent) 55%, var(--fw-bg));left:57%;top:29%;}.fw-hero__shape--c{height:30%;width:37%;border-radius:120px 40px 80px 30px;transform:rotate(35deg);background:var(--fw-bg);left:9%;bottom:12%;}
.fw-hero__floating{position:absolute;display:flex;align-items:center;gap:12px;bottom:0;left:0;width:min(300px,85%);min-height:86px;padding:12px;background:var(--scheme-background, var(--fw-bg));color:var(--fw-title);border:1px solid var(--fw-line);border-radius:var(--theme-radius, var(--fw-radius));text-decoration:none;box-shadow:0 16px 40px color-mix(in srgb, var(--fw-title) 12%, transparent);}
.fw-hero__floating img,.fw-hero__mini{height:55px;width:55px;flex:0 0 55px;object-fit:cover;border-radius:var(--sl-image-radius, 9px);background:linear-gradient(135deg, var(--scheme-background-secondary, var(--fw-line)), var(--fw-accent));}
.fw-hero__floating small,.fw-hero__floating strong{display:block}.fw-hero__floating small{font-size:var(--type-caption-size, 11px);letter-spacing:var(--type-caption-tracking, .08em);text-transform:var(--type-caption-transform, uppercase);opacity:.7;margin-bottom:4px}.fw-hero__floating strong{font-size:var(--type-body-small-size, 13px);line-height:1.3;font-weight:var(--type-body-weight, 650)}.fw-hero__floating>span:last-child{margin-left:auto;align-self:flex-start}
@container(max-width:1080px){.fw-hero__layout{grid-template-columns:1fr;min-height:0;gap:22px}.fw-hero__copy{padding-block:0}.fw-hero__art{min-height:0;padding-bottom:24px}.fw-hero__frame,.fw-hero__placeholder{min-height:300px}.fw-hero__floating{bottom:0}}
@container(max-width:460px){.fw-hero__buttons .fw__action{flex:1 1 auto}.fw-hero__frame,.fw-hero__placeholder{min-height:270px;aspect-ratio:1.05}.fw-hero__art{padding-left:0}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_hero",
  "name": "Foundation / Editorial hero",
  "category": "hero",
  "description": "Responsive split hero with editable main image, floating feature card, two CTAs, and polished image-free fallback.",
  "version": "1.0.0",
  "icon": "image",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "THE EVERYDAY COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Good things, thoughtfully made."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "A home for products and ideas worth keeping. Explore what’s new, find your favourites, and make something your own."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary link",
      "default": "/products"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary link",
      "default": "/about"
    },
    {
      "type": "text",
      "id": "small_note",
      "label": "Small note",
      "default": "Thoughtful design. Simple experience."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image description",
      "default": "A curated collection of products"
    },
    {
      "type": "checkbox",
      "id": "show_floating_card",
      "label": "Show floating feature card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Feature card image",
      "default": ""
    },
    {
      "type": "text",
      "id": "card_kicker",
      "label": "Feature card overline",
      "default": "START HERE"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Feature card title",
      "default": "Discover what’s new"
    },
    {
      "type": "url",
      "id": "card_url",
      "label": "Feature card link",
      "default": "/products"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 76,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "theme",
      "options": [
        {"value": "theme", "label": "Theme setting"},
        {"value": "none", "label": "None"},
        {"value": "fade", "label": "Fade"},
        {"value": "fade_up", "label": "Fade up"},
        {"value": "rise", "label": "Rise"},
        {"value": "zoom", "label": "Zoom"},
        {"value": "blur", "label": "Blur"},
        {"value": "slide_left", "label": "From the right"},
        {"value": "slide_right", "label": "From the left"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    },
    {
      "name": "Minimal product hero",
      "settings": {
        "show_floating_card": false,
        "heading": "Find something you’ll love.",
        "eyebrow": "EXPLORE THE STORE"
      }
    }
  ]
}
</schema>
