<template>
<section class="s fi fi--{{ settings.image_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --s-mark-bg: {{ settings.marker_bg | default: scheme.border }}; --s-mark-text: {{ settings.marker_text | default: scheme.heading }};">
  <div class="s__in s__in--{{ settings.max_width }} fi__in">
    <div class="fi__media">
      {% if settings.image %}<img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="lazy" decoding="async">{% else %}<div class="fi__placeholder" aria-hidden="true"></div>{% endif %}
    </div>
    <div class="fi__copy">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
      {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      {% if blocks.size > 0 %}
        <div class="fi__list">
          {% for block in blocks %}
            <div class="fi__item" data-block-id="{{ block.id }}">

              {% if settings.marker == 'image' and block.settings.image %}
                <img class="mark mark--img" src="{{ block.settings.image | asset }}" alt="" loading="lazy" decoding="async">
              {% elsif settings.marker == 'number' %}
                <span class="mark" aria-hidden="true">{{ forloop.index }}</span>
              {% endif %}
              <div>
                <h3 class="f__title">{{ block.settings.title }}</h3>
                {% if block.settings.text %}<p class="f__text">{{ block.settings.text }}</p>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if settings.button_text %}
        <div class="s__btns"><a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a></div>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.mark {
  display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; border-radius: 10px; margin-bottom: 14px;
  font-size: 14px; font-weight: 700; background: var(--s-mark-bg); color: var(--s-mark-text);
}
.f__title { margin: 0; font-size: 16px; font-weight: 600; color: var(--s-heading); }
.f__text { margin: 6px 0 0; font-size: 14px; line-height: 1.6; color: var(--s-para); }

.fi__in { display: grid; gap: 36px; align-items: center; grid-template-columns: 1fr; }
@container (min-width: 860px) { .fi__in { grid-template-columns: 1fr 1fr; gap: 56px; } .fi--right .fi__media { order: 2; } }
.fi__media { overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); }
.fi__media img { display: block; width: 100%; object-fit: cover; aspect-ratio: 4 / 5; }
.fi__placeholder { width: 100%; aspect-ratio: 4 / 5; }
.fi__copy { max-width: 32rem; }
.fi__list { margin-top: 26px; display: grid; gap: 22px; }
.fi__item { display: flex; gap: 14px; align-items: flex-start; }
.fi__item .mark { margin-bottom: 0; flex: none; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "features_image",
  "name": "Image + Features",
  "category": "features",
  "description": "A picture on one side, the points beside it.",
  "version": "1.0.0",
  "icon": "columns",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why people come back"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": ""
    },
    {
      "type": "radio",
      "id": "image_side",
      "label": "Image on",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "marker",
      "label": "Marker",
      "default": "number",
      "options": [
        {
          "label": "Number",
          "value": "number"
        },
        {
          "label": "Image",
          "value": "image"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },
    {
      "type": "color",
      "id": "marker_bg",
      "label": "Marker background",
      "default": ""
    },
    {
      "type": "color",
      "id": "marker_text",
      "label": "Marker text",
      "default": ""
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A short title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Two lines about what this is and why it matters."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "default": "",
          "info": "Used when the marker is set to Image."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Image + Features",
      "settings": {},
      "blocks": [
        {
          "id": "b1",
          "type": "point",
          "settings": {
            "title": "Made in small runs",
            "text": "Nothing is mass produced, so nothing is quite identical."
          }
        },
        {
          "id": "b2",
          "type": "point",
          "settings": {
            "title": "Sent within a week",
            "text": "Orders leave the studio every Tuesday and Friday."
          }
        },
        {
          "id": "b3",
          "type": "point",
          "settings": {
            "title": "Easy to send back",
            "text": "Thirty days, no questions, return label included."
          }
        }
      ]
    }
  ]
}
</schema>
