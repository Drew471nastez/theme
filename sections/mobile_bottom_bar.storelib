<template>
{# A row of links fixed to the bottom of a phone's screen, as shopping apps
   have. Wider screens never see it. A spacer of the same height keeps the
   footer from ending up underneath it. In the builder it is drawn in the
   page, so it can be selected at any width. The page publishes the bar's
   height as --sl-bottom-bar-h, so back to top and a popup sit above it. #}
<div class="mb {% if page.in_editor %}mb--canvas{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--mb-bg: {{ scheme.bg }}; --mb-text: {{ scheme.paragraph }}; --mb-active: {{ settings.active_color | default: scheme.heading }}; --mb-border: {{ scheme.border }}; --mb-h: {{ settings.height }}px;">
  <div class="mb__space" aria-hidden="true"></div>
  <nav class="mb__bar" aria-label="{{ settings.label }}" data-storelib-bottom-bar>
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="mb__empty">Add links in the sidebar</p>{% endif %}
    {% endif %}
    {% for block in blocks %}
      {% if block.settings.does == 'cart' %}
        <button class="mb__item" type="button" data-block-id="{{ block.id }}" data-storelib-cart>
      {% elsif block.settings.does == 'search' %}
        <button class="mb__item" type="button" data-block-id="{{ block.id }}" data-storelib-search>
      {% elsif block.settings.does == 'menu' %}
        <button class="mb__item" type="button" data-block-id="{{ block.id }}" data-storelib-menu>
      {% else %}
        <a class="mb__item" data-block-id="{{ block.id }}" href="{{ block.settings.url | default: '/' | url }}">
      {% endif %}
        <span class="mb__icon" aria-hidden="true">
            {% if block.settings.icon == 'home' %}<svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
            {% elsif block.settings.icon == 'shop' %}<svg viewBox="0 0 24 24"><path d="M4 7h16l-1.5 13h-13zM9 7a3 3 0 0 1 6 0"/></svg>
            {% elsif block.settings.icon == 'search' %}<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            {% elsif block.settings.icon == 'cart' %}<svg viewBox="0 0 24 24"><path d="M3 4h2l2.4 11h11L21 7H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
            {% elsif block.settings.icon == 'account' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            {% elsif block.settings.icon == 'heart' %}<svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9-9.3C1.9 7.2 4.2 4 7.5 4c2 0 3.4 1.1 4.5 2.6C13.1 5.1 14.5 4 16.5 4c3.3 0 5.6 3.2 4.5 6.7C19.5 15.4 12 20 12 20z"/></svg>
            {% elsif block.settings.icon == 'menu' %}<svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            {% elsif block.settings.icon == 'chat' %}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg>
          {% endif %}
          {% if block.settings.does == 'cart' %}<span class="mb__count" data-storelib-cart-count></span>{% endif %}
        </span>
        {% if settings.show_labels %}<span class="mb__label">{{ block.settings.label }}</span>{% elsif block.settings.label %}<span class="mb__sr">{{ block.settings.label }}</span>{% endif %}
      {% if block.settings.does == 'cart' or block.settings.does == 'search' or block.settings.does == 'menu' %}</button>{% else %}</a>{% endif %}
    {% endfor %}
  </nav>
</div>
</template>

<style scoped>
.mb { display: none; }
/* The screen's width, not the page's: written so it stays a media query
   (a width-only one is read as a container query, and a bar fixed to the
   screen has no container to ask). Below 750px. */
@media not all and (min-width: 750px) { .mb { display: block; } }
.mb__space { height: calc(var(--mb-h) + env(safe-area-inset-bottom, 0px)); }
.mb__bar {
  position: fixed; z-index: 55; left: 0; right: 0; bottom: 0; box-sizing: border-box;
  display: flex; align-items: stretch;
  height: calc(var(--mb-h) + env(safe-area-inset-bottom, 0px)); padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
  background: var(--mb-bg); border-top: 1px solid var(--mb-border);
}
.mb__item {
  flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
  padding: 0; margin: 0; border: 0; background: none; font: inherit; font-size: 11px; font-weight: 500; line-height: 1.2;
  color: var(--mb-text); text-decoration: none; cursor: pointer; -webkit-tap-highlight-color: transparent;
}
.mb__item:hover, .mb__item:focus-visible, .mb__item[aria-current="page"] { color: var(--mb-active); }
.mb__item:focus-visible { outline: 2px solid var(--mb-active); outline-offset: -4px; border-radius: 8px; }
.mb__icon { position: relative; display: inline-flex; }
.mb__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.mb__count:empty { display: none; }
.mb__count {
  position: absolute; top: -5px; right: -9px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px;
  background: var(--mb-active); color: var(--mb-bg); font-size: 10px; font-weight: 700; line-height: 16px; text-align: center;
}
.mb__label { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mb__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.mb__empty { margin: auto; font-size: 13px; color: var(--mb-text); opacity: 0.6; }

/* In the builder: in the page at every width, so it can be selected and edited. */
.mb--canvas { display: block; }
.mb--canvas .mb__space { display: none; }
.mb--canvas .mb__bar { position: relative; height: var(--mb-h); padding: 0; max-width: 480px; margin: 0 auto; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "mobile_bottom_bar",
  "name": "Phone tab bar",
  "category": "overlay",
  "description": "Links fixed to the bottom of the screen on phones: home, shop, search, cart, account.",
  "version": "1.0.0",
  "icon": "smartphone",
  "enabled_on": { "groups": ["overlay"] },
  "supports_typography_overrides": false,
  "max_blocks": 5,
  "settings": [
    { "type": "header", "id": "hdr_bar", "label": "Bar" },
    { "type": "toggle", "id": "show_labels", "label": "Show labels under the icons", "default": true },
    { "type": "range", "id": "height", "label": "Height", "default": 60, "min": 48, "max": 80, "step": 2, "unit": "px" },
    { "type": "text", "id": "label", "label": "Name read aloud", "default": "Shortcuts" },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "color", "id": "active_color", "label": "Pressed colour", "default": "", "info": "Empty uses the scheme's heading colour." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Home" },
        {
          "type": "select", "id": "does", "label": "Opens", "default": "link",
          "options": [
            { "label": "A page", "value": "link" },
            { "label": "The cart", "value": "cart" },
            { "label": "Search", "value": "search" },
            { "label": "The menu", "value": "menu" }
          ]
        },
        { "type": "url", "id": "url", "label": "Page", "default": "/", "info": "Used when Opens is A page." },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "home",
          "options": [
            { "label": "Home", "value": "home" },
            { "label": "Shop", "value": "shop" },
            { "label": "Search", "value": "search" },
            { "label": "Cart", "value": "cart" },
            { "label": "Account", "value": "account" },
            { "label": "Heart", "value": "heart" },
            { "label": "Menu", "value": "menu" },
            { "label": "Chat", "value": "chat" },
            { "label": "None", "value": "none" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Phone tab bar",
      "blocks": [
        { "id": "b1", "type": "item", "settings": { "label": "Home", "does": "link", "url": "/", "icon": "home" } },
        { "id": "b2", "type": "item", "settings": { "label": "Shop", "does": "link", "url": "/products", "icon": "shop" } },
        { "id": "b3", "type": "item", "settings": { "label": "Search", "does": "search", "url": "", "icon": "search" } },
        { "id": "b4", "type": "item", "settings": { "label": "Cart", "does": "cart", "url": "", "icon": "cart" } }
      ]
    }
  ]
}
</schema>
