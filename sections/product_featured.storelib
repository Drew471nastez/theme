<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %} s__headblock">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {# Four sources, one card: the shop, a collection, products chosen in the
       sidebar, and cards picked one by one. See sections/product_grid.storelib. #}
    {% if settings.source == 'shop' %}
      {% if products.size == 0 %}
        {% if page.in_editor %}<p class="empty">Your published products appear here</p>{% endif %}
      {% else %}
        <div class="grid">
          {% for block in products limit: settings.product_count %}
          <article class="card feat" data-card="product" data-block-id="{{ block.id }}">
            <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
              {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
            </div>
            <div class="feat__body">
              {% if block.settings.tag %}<p class="feat__tag">{{ block.settings.tag }}</p>{% endif %}
              <h3 class="card__title">{{ block.settings.title }}</h3>
              {% if settings.show_rating and block.rating.count > 0 %}<p class="card__rating"><span role="img" aria-label="{{ words.rated }} {{ block.rating.value }} {{ words.out_of_five }}">&#9733;&#9733;&#9733;&#9733;&#9733;<span aria-hidden="true" style="width:{{ block.rating.percent }}%;color:{{ block.rating.color }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>({{ block.rating.count }})</p>{% endif %}
              {% if block.settings.text %}<p class="card__text">{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.price %}
                <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
              {% endif %}
              {% if block.settings.url %}<a class="feat__go" href="{{ block.settings.url | url }}">{{ settings.link_text }}</a>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      {% endif %}
    {% elsif settings.source == 'collection' %}
      {# One collection's products, in the collection's own order (Products › Collections). #}
      {% if settings.collection.products.size > 0 %}
        <div class="grid">
          {% for block in settings.collection.products limit: settings.product_count %}
          <article class="card feat" data-card="product" data-block-id="{{ block.id }}">
            <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
              {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
            </div>
            <div class="feat__body">
              {% if block.settings.tag %}<p class="feat__tag">{{ block.settings.tag }}</p>{% endif %}
              <h3 class="card__title">{{ block.settings.title }}</h3>
              {% if settings.show_rating and block.rating.count > 0 %}<p class="card__rating"><span role="img" aria-label="{{ words.rated }} {{ block.rating.value }} {{ words.out_of_five }}">&#9733;&#9733;&#9733;&#9733;&#9733;<span aria-hidden="true" style="width:{{ block.rating.percent }}%;color:{{ block.rating.color }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>({{ block.rating.count }})</p>{% endif %}
              {% if block.settings.text %}<p class="card__text">{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.price %}
                <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
              {% endif %}
              {% if block.settings.url %}<a class="feat__go" href="{{ block.settings.url | url }}">{{ settings.link_text }}</a>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      {% elsif page.in_editor %}<p class="empty">{% if settings.collection.title %}This collection has no published products yet{% else %}Choose a collection in the sidebar{% endif %}</p>
      {% endif %}
    {% elsif settings.source == 'chosen' %}
      {# Real products, in the order they were chosen. One that is unpublished or deleted is left out. #}
      {% if settings.chosen.size > 0 %}
        <div class="grid">
          {% for block in settings.chosen %}
          <article class="card feat" data-card="product" data-block-id="{{ block.id }}">
            <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
              {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
            </div>
            <div class="feat__body">
              {% if block.settings.tag %}<p class="feat__tag">{{ block.settings.tag }}</p>{% endif %}
              <h3 class="card__title">{{ block.settings.title }}</h3>
              {% if settings.show_rating and block.rating.count > 0 %}<p class="card__rating"><span role="img" aria-label="{{ words.rated }} {{ block.rating.value }} {{ words.out_of_five }}">&#9733;&#9733;&#9733;&#9733;&#9733;<span aria-hidden="true" style="width:{{ block.rating.percent }}%;color:{{ block.rating.color }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>({{ block.rating.count }})</p>{% endif %}
              {% if block.settings.text %}<p class="card__text">{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.price %}
                <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
              {% endif %}
              {% if block.settings.url %}<a class="feat__go" href="{{ block.settings.url | url }}">{{ settings.link_text }}</a>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      {% elsif page.in_editor %}<p class="empty">Choose products in the sidebar</p>
      {% endif %}
    {% else %}{# HAND-FILLED: cards whose product is picked one by one, with words of their own; kept so a section made that way draws what it always drew. The copy an agent reads (lib/storelib-ai/reference.ts) has this branch taken out. #}
      {% if blocks.size == 0 %}
        {% if page.in_editor %}<p class="empty">Add products in the sidebar</p>{% endif %}
      {% else %}
        <div class="grid">
          {% for block in blocks %}
          {% if block.settings.title or block.settings.url.title %}
          <article class="card feat" data-card="product" data-block-id="{{ block.id }}">
            <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
              {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title | default: block.settings.url.title }}" loading="lazy" decoding="async">{% elsif block.settings.url.image %}<img src="{{ block.settings.url.image | asset }}" alt="{{ block.settings.title | default: block.settings.url.title }}" loading="lazy" decoding="async">{% endif %}
            </div>
            <div class="feat__body">
              {% if block.settings.tag %}<p class="feat__tag">{{ block.settings.tag }}</p>{% endif %}
              <h3 class="card__title">{{ block.settings.title | default: block.settings.url.title }}</h3>
              {% if settings.show_rating and block.settings.url.rating.count > 0 %}<p class="card__rating"><span role="img" aria-label="{{ words.rated }} {{ block.settings.url.rating.value }} {{ words.out_of_five }}">&#9733;&#9733;&#9733;&#9733;&#9733;<span aria-hidden="true" style="width:{{ block.settings.url.rating.percent }}%;color:{{ block.settings.url.rating.color }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>({{ block.settings.url.rating.count }})</p>{% endif %}
              {% if block.settings.text %}<p class="card__text">{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.price or block.settings.url.price %}
                <p class="card__price">{{ block.settings.url.price | default: block.settings.price }}{% if block.settings.url.title %}{% if block.settings.url.compare_price %}<s class="card__was">{{ block.settings.url.compare_price }}</s>{% endif %}{% elsif block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
              {% endif %}
              {% if block.settings.url %}<a class="feat__go" href="{{ block.settings.url | url }}">{{ settings.link_text }}</a>{% endif %}
            </div>
          </article>
          {% elsif page.in_editor %}
          <p class="empty" data-block-id="{{ block.id }}">Choose a product for this card</p>
          {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {# END HAND-FILLED #}{% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.s__headblock { margin-bottom: 40px; }
.grid { display: grid; gap: 24px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.card { display: flex; flex-direction: column; }
.card__media { overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 14px 0 0; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__rating { margin: 6px 0 0; display: flex; align-items: center; gap: 6px; font-size: 13px; line-height: 1; color: var(--s-para); }
.card__rating > span { position: relative; letter-spacing: 1px; color: var(--s-border); }
.card__rating > span > span { position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; }
.card__text { margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: var(--s-para); }
.card__price { margin: 8px 0 0; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.7; }
.card__link { position: absolute; inset: 0; }
.card__wrap { position: relative; }
.empty { margin: 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.55; }

.feat { border: 1px solid var(--s-border); border-radius: var(--s-radius); overflow: hidden; background: var(--s-bg); }
.feat .card__media { border-radius: 0; }
.feat__body { padding: 20px; }
.feat__tag { margin: 0 0 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--s-accent); }
.feat__go { display: inline-block; margin-top: 14px; font-size: 14px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "product_featured",
  "name": "Featured Products",
  "category": "products",
  "description": "A handful of products, shown larger, with room for a line about each.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "info": "Your shop, a collection and the products you choose stay in step on their own. Cards with your own words pick a product each and can add a line about it.",
      "default": "picked",
      "options": [
        {
          "label": "All products, newest first",
          "value": "shop"
        },
        {
          "label": "A collection",
          "value": "collection"
        },
        {
          "label": "Products I choose",
          "value": "chosen"
        },
        {
          "label": "Cards with my own words",
          "value": "picked"
        }
      ]
    },
    {
      "type": "product_list",
      "id": "chosen",
      "label": "Products to show",
      "limit": 12,
      "default": [],
      "visible_if": "{{ section.settings.source == 'chosen' }}"
    },
    {
      "type": "collection_picker",
      "id": "collection",
      "label": "Collection",
      "info": "Its products in its own order, up to 12.",
      "visible_if": "{{ section.settings.source == 'collection' }}"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.source == 'shop' or section.settings.source == 'collection' }}"
    },
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worth a closer look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Photo shape",
      "default": "4 / 3",
      "options": [
        {
          "label": "Landscape",
          "value": "4 / 3"
        },
        {
          "label": "Square",
          "value": "1 / 1"
        },
        {
          "label": "Portrait",
          "value": "3 / 4"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "show_rating",
      "label": "Show star ratings",
      "default": true,
      "info": "From Storelib Reviews, when it is on and a product has reviews."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link wording",
      "default": "See the details"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product_picker",
          "id": "url",
          "label": "Product",
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "info": "Empty uses the product's name, price and photo.",
          "default": ""
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": ""
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Was",
          "default": ""
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Corner label",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "One line about it",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "source": "shop"
      },
      "blocks": []
    }
  ]
}
</schema>
