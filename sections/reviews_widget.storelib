{# ===========================================================================
   Reviews widget (Storelib Reviews)

   One of the store's review widgets (lib/reviews/widgets): the product's
   reviews, the stars under a title, a grid, a carousel, testimonials, a
   photo wall, a strip that scrolls by, a trust badge or a rating summary.
   Which one is `widget`; its look is the saved configuration it names
   (`review_config`, made in Storelib Reviews › Widgets) with the few things
   this page changes laid over it. Drawn by `review_widget`, the same
   function the gallery and an imported theme use, from `reviews`
   (lib/reviews/storefront.ts): published reviews only, never sample ones
   on a live page. With Storelib Reviews off it draws nothing.
   =========================================================================== #}
<template>
{% if reviews.enabled %}
<section class="s rw" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
{{ settings | review_widget }}
</section>
{% endif %}
</template>

<style scoped>
{{ settings | review_widget_css }}
.s { background: var(--s-bg); color: var(--s-text); padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) 0 calc(var(--s-pb) * var(--theme-spacing-scale, 1)); --slw-theme-hs: var(--section-heading-size, 32px); }
/* The theme's heading style (Theme settings › Typography, the section's heading style), unless the saved look picks its own font or size. */
.s .slw__h {
  font-family: var(--slw-font, var(--section-heading-font, var(--theme-font-heading, inherit)));
  font-weight: var(--section-heading-weight, 700);
  line-height: var(--section-heading-line-height, 1.15);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
}

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

