      "default": "75%",
      "options": [
        {
          "label": "50%",
          "value": "50%"
        },
        {
          "label": "66%",
          "value": "66.6666%"
        },
        {
          "label": "75%",
          "value": "75%"
        },
        {
          "label": "100%",
          "value": "100%"
        }
      ]
    },
    {
      "id": "position",
      "label": "Content position",
      "type": "select",
      "default": "left",
      "options": [
        {
          "label": "Content left",
          "value": "left"
        },
        {
          "label": "Content right",
          "value": "right"
        }
      ]
