<template>
<section class="s hero" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; {% if settings.background == 'gradient' %}--s-bg: linear-gradient(160deg, {{ settings.gradient_from }} 0%, {{ settings.gradient_to }} 100%);{% elsif settings.background == 'image' and settings.image %}--s-bg: transparent;{% endif %}{% if settings.full_height %}--hero-min: calc(var(--sl-vh, 1vh) * 78);{% endif %}">
  {% if settings.background == 'image' and settings.image %}
    <img class="hero__bg" src="{{ settings.image | asset }}" alt="" loading="eager" fetchpriority="high" decoding="async">
    <div class="hero__veil" style="background: {{ settings.overlay_color }}; opacity: {{ settings.overlay_opacity | divided_by: 100 }};"></div>
  {% endif %}
  <div class="s__in s__in--{{ settings.max_width }} hero__in">
    <div class="s__head s__head--center">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {% if settings.heading %}<h1 class="s__h">{{ settings.heading }}</h1>{% endif %}
      {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      {% if settings.button_text or settings.button2_text %}
        <div class="s__btns">
          {% if settings.button_text %}<a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
          {% if settings.button2_text %}<a class="s__btn s__btn--secondary" href="{{ settings.button2_url | default: '#' | url }}">{{ settings.button2_text }}</a>{% endif %}
        </div>
      {% endif %}
      {% if settings.note %}<p class="s__note">{{ settings.note }}</p>{% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.hero { position: relative; overflow: hidden; }
.hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hero__veil { position: absolute; inset: 0; }
.hero__in { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: var(--hero-min, 0); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "hero_centered",
  "name": "Centered Hero",
  "category": "hero",
  "description": "Heading, supporting line and two buttons, centred over a colour, image or gradient.",
  "version": "1.0.0",
  "icon": "layout",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "",
      "placeholder": "New this week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you make, in one place"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "Sell your work to the people who already follow you, without setting up a shop from scratch."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Browse the shop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/products"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Second button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Second button link",
      "default": ""
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "",
      "placeholder": "Free delivery over $50"
    },
    {
      "type": "header",
      "id": "hdr_bg",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "colour",
      "options": [
        {
          "label": "Colour scheme",
          "value": "colour"
        },
        {
          "label": "Image",
          "value": "image"
        },
        {
          "label": "Gradient",
          "value": "gradient"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "default": ""
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "default": 45,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient from",
      "default": "scheme.background"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient to",
      "default": "scheme.background_secondary"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "medium",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "full_height",
      "label": "Fill most of the screen",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Centered Hero"
    },
    {
      "name": "Centered Hero on an image",
      "settings": {
        "background": "image",
        "color_scheme": "dark",
        "overlay_opacity": 55
      }
    }
  ]
}
</schema>
