{# ===========================================================================
   Product reviews (Storelib Reviews)

   The reviews of the product the page is about, with their summary and,
   when the store lets anyone write, a form to write one. Anywhere else it
   shows the whole shop's reviews. Everything comes from `reviews`
   (lib/reviews/storefront.ts): published reviews only, a first name and an
   initial, never an address. With Storelib Reviews off it draws nothing on
   a live page.

   The form posts to the store (data-storelib-form="native") and comes back
   to this page at #review-posted, #review-waiting, #review-check-email or
   #review-error, which the notes below answer with :target, so it works
   with no script at all. So does the rest: the filter by stars is a row of
   radio inputs and the order a <select>, read with :has() (a filter or an
   order other than the store's shows every review sent, sorted with CSS
   `order` from each review's rank_*); "Show more" is a checkbox; a photo
   opens larger in a popover. A product page is sent up to 100 reviews.
   =========================================================================== #}
<template>
{% if reviews.enabled %}
{% if reviews.here.summary.count > 0 or reviews.can_write or page.in_editor %}
<section class="s rv" id="reviews" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }}; --rv-star: {{ settings.star_color | default: reviews.star_color }};{% if settings.bar_color %} --rv-bar: {{ settings.bar_color }};{% endif %}{% if settings.verified_color %} --rv-ver: {{ settings.verified_color }};{% endif %}">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.heading %}<h2 class="s__h rv__h">{{ settings.heading }}</h2>{% endif %}
    {% if page.in_editor and reviews.sample %}<p class="rv__sample">Sample reviews. Your real reviews show here once you have some.</p>{% endif %}

    <div class="rv__top">
      {% if settings.show_summary %}
        <div class="rv__sum">
          {% if reviews.here.summary.count > 0 %}
            <p class="rv__avg">{{ reviews.here.summary.average_label }}</p>
            <div>
              <span class="rv-stars rv-stars--lg" style="--rv: {{ reviews.here.summary.percent }}%;" role="img" aria-label="{{ reviews.here.summary.average_label }} {{ words.out_of_five_stars }}"></span>
              <p class="rv__count">{{ words.based_on }} {{ reviews.here.summary.count }} {% if reviews.here.summary.count == 1 %}{{ words.review }}{% else %}{{ words.reviews }}{% endif %}</p>
            </div>
          {% else %}
            <p class="rv__none">{{ words.no_reviews_yet }}</p>
          {% endif %}
        </div>
        {% if settings.show_bars and reviews.here.summary.count > 0 %}
          <ul class="rv__bars" aria-label="{{ words.reviews_by_rating }}">
            {% for b in reviews.here.summary.bars %}<li><span class="rv__bar-n">{{ b.stars }}<span aria-hidden="true"> &#9733;</span></span><span class="rv__bar"><span style="width: {{ b.percent }}%;"></span></span><span class="rv__bar-c">{{ b.count }}</span></li>{% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    </div>

    <p class="rv-note" id="review-posted">{{ words.review_posted }}</p>
    <p class="rv-note" id="review-waiting">{{ words.review_waiting }}</p>
    <p class="rv-note" id="review-check-email">{{ words.review_check_email }}</p>
    <p class="rv-note rv-note--error" id="review-error">{{ words.review_error }}</p>

    {% if settings.show_write and reviews.can_write and reviews.here.scope == 'product' %}
      <details class="rv-write">
        <summary class="rv-btn">{{ words.write_a_review }}</summary>
        <form class="rv-form" method="post" action="{{ reviews.form_action }}" enctype="multipart/form-data" data-storelib-form="native">
          <input type="hidden" name="productId" value="{{ reviews.here.product_id }}">
          <fieldset class="rv-form__rate">
            <legend>{{ words.your_rating }}</legend>
            <div class="rv-rate">
              <input type="radio" id="rv-r5" name="rating" value="5" required><label for="rv-r5" title="5 {{ words.stars }}"><span class="sr">5 {{ words.stars }}</span></label>
              <input type="radio" id="rv-r4" name="rating" value="4"><label for="rv-r4" title="4 {{ words.stars }}"><span class="sr">4 {{ words.stars }}</span></label>
              <input type="radio" id="rv-r3" name="rating" value="3"><label for="rv-r3" title="3 {{ words.stars }}"><span class="sr">3 {{ words.stars }}</span></label>
              <input type="radio" id="rv-r2" name="rating" value="2"><label for="rv-r2" title="2 {{ words.stars }}"><span class="sr">2 {{ words.stars }}</span></label>
              <input type="radio" id="rv-r1" name="rating" value="1"><label for="rv-r1" title="1 {{ words.star }}"><span class="sr">1 {{ words.star }}</span></label>
            </div>
          </fieldset>
          <label class="rv-form__f"><span>{{ words.review_title }} <span class="rv-form__opt">{{ words.optional }}</span></span><input name="title" maxlength="120"></label>
          <label class="rv-form__f">{{ words.your_review }}<textarea name="content" rows="4" required minlength="2" maxlength="2000"></textarea></label>
          <div class="rv-form__two">
            <label class="rv-form__f">{{ words.your_name }}<input name="name" required maxlength="40" autocomplete="given-name"></label>
            <label class="rv-form__f">{{ words.email }}<input type="email" name="email" required maxlength="254" autocomplete="email"></label>
          </div>
          {% if reviews.photos_allowed %}<label class="rv-form__f"><span>{{ words.photos }} <span class="rv-form__opt">{{ words.optional_up_to_four }}</span></span><input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple></label>{% endif %}
          <div class="rv-hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <p class="rv-form__note">{{ words.review_privacy }}</p>
          <button class="rv-btn" type="submit">{{ words.post_review }}</button>
        </form>
      </details>
    {% endif %}

    {% if reviews.here.items.size > 0 %}
      {% if settings.show_tools and reviews.here.items.size > 1 %}
        <div class="rv__tools">
          <div class="rv-chips" role="radiogroup" aria-label="{{ words.reviews_by_rating }}">
            <input class="rv-f rv-f--0" type="radio" name="rv-f-{{ section.id }}" id="rv-f0-{{ section.id }}" checked><label class="rv-chip" for="rv-f0-{{ section.id }}">{{ words.filter_all }}</label>
            {% for b in reviews.here.summary.bars %}{% if b.count > 0 %}<input class="rv-f rv-f--{{ b.stars }}" type="radio" name="rv-f-{{ section.id }}" id="rv-f{{ b.stars }}-{{ section.id }}"><label class="rv-chip" for="rv-f{{ b.stars }}-{{ section.id }}">{{ b.stars }}<span aria-hidden="true"> &#9733;</span><span class="sr"> {% if b.stars == 1 %}{{ words.star }}{% else %}{{ words.stars }}{% endif %}</span></label>{% endif %}{% endfor %}
          </div>
          <label class="rv-sort"><span class="sr">{{ words.sort_reviews }}</span>
            <select class="rv-sort__s">
              <option value="featured"{% if reviews.sort == 'featured' %} selected{% endif %}>{{ words.sort_featured }}</option>
              <option value="newest"{% if reviews.sort == 'newest' %} selected{% endif %}>{{ words.sort_newest }}</option>
              <option value="highest"{% if reviews.sort == 'highest' %} selected{% endif %}>{{ words.sort_highest }}</option>
              <option value="lowest"{% if reviews.sort == 'lowest' %} selected{% endif %}>{{ words.sort_lowest }}</option>
              <option value="photos"{% if reviews.sort == 'photos' %} selected{% endif %}>{{ words.sort_with_photos }}</option>
            </select>
          </label>
        </div>
      {% endif %}
      <div class="rv__list rv__list--{{ settings.layout }}">
        {% for r in reviews.here.items %}
          <article class="rv-card{% if settings.per_page > 0 %}{% if forloop.index > settings.per_page %} rv-card--more{% endif %}{% elsif forloop.index > reviews.per_page %} rv-card--more{% endif %}" data-review-id="{{ r.id }}" data-rating="{{ r.rating }}" style="--o-featured: {{ r.rank_featured }}; --o-newest: {{ r.rank_newest }}; --o-highest: {{ r.rank_highest }}; --o-lowest: {{ r.rank_lowest }}; --o-photos: {{ r.rank_photos }};">
            <div class="rv-card__top">
              <span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span>
              {% if reviews.show_date %}<span class="rv-card__date">{{ r.date }}</span>{% endif %}
            </div>
            {% if r.title %}<h3 class="rv-card__title">{{ r.title }}</h3>{% endif %}
            <p class="rv-card__body">{{ r.body }}</p>
            {% if reviews.show_photos and r.has_photos %}<div class="rv-card__photos">{% for ph in r.photos %}<button type="button" class="rv-ph" popovertarget="rv-lb-{{ section.id }}-{{ r.id }}-{{ forloop.index }}"><img src="{{ ph }}" alt="{{ words.photo_from }} {{ r.author }}" loading="lazy" decoding="async"></button><div class="rv-lb" id="rv-lb-{{ section.id }}-{{ r.id }}-{{ forloop.index }}" popover><img src="{{ ph }}" alt="{{ words.photo_from }} {{ r.author }}" loading="lazy" decoding="async"><p class="rv-lb__bar"><a href="{{ ph | url }}" target="_blank" rel="noopener">{{ words.open_full_size }}</a><button type="button" popovertarget="rv-lb-{{ section.id }}-{{ r.id }}-{{ forloop.index }}" popovertargetaction="hide">{{ words.close }}</button></p></div>{% endfor %}</div>{% endif %}
            {% if reviews.show_photos and r.videos.size > 0 %}<p class="rv-card__videos">{% for v in r.videos %}<a href="{{ v | url }}" target="_blank" rel="noopener">{{ words.watch_video }}</a>{% endfor %}</p>{% endif %}
            <p class="rv-card__by"><span class="rv-card__av" aria-hidden="true">{{ r.initial }}</span><span class="rv-card__name">{{ r.author }}</span>{% if reviews.show_verified and r.verified %}<span class="rv-card__ver">{{ words.verified_buyer }}</span>{% endif %}</p>
            {% if reviews.here.scope == 'shop' and r.product_title %}<p class="rv-card__product">{{ words.review_on }} {% if r.product_url %}<a href="{{ r.product_url | url }}">{{ r.product_title }}</a>{% else %}{{ r.product_title }}{% endif %}</p>{% endif %}
            {% if r.reply %}<div class="rv-card__reply"><p class="rv-card__reply-by">{{ words.reply_from }} {{ shop.name }}</p><p class="rv-card__body">{{ r.reply }}</p></div>{% endif %}
          </article>
        {% endfor %}
      </div>
      <p class="rv__nomatch">{{ words.no_reviews_with_rating }}</p>
      {% if settings.per_page > 0 %}
        {% if reviews.here.items.size > settings.per_page %}<input class="rv-more-t sr" type="checkbox" id="rv-more-{{ section.id }}"><label class="rv-btn rv-btn--quiet rv-more-b" for="rv-more-{{ section.id }}">{{ words.show_more_reviews }}</label>{% endif %}
      {% elsif reviews.here.items.size > reviews.per_page %}<input class="rv-more-t sr" type="checkbox" id="rv-more-{{ section.id }}"><label class="rv-btn rv-btn--quiet rv-more-b" for="rv-more-{{ section.id }}">{{ words.show_more_reviews }}</label>
      {% endif %}
      {% if reviews.here.summary.count > reviews.here.items.size %}<p class="rv__showing">{{ words.showing }} {{ reviews.here.items.size }} {{ words.of }} {{ reviews.here.summary.count }} {{ words.reviews }}</p>{% endif %}
    {% endif %}
  </div>
</section>
{% endif %}
{% endif %}
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.rv__h { margin-bottom: 24px; }
.rv__sample { margin: -12px 0 20px; font-size: 13px; color: var(--s-para); opacity: 0.7; }

.rv-stars { position: relative; display: inline-block; font-size: 16px; line-height: 1; letter-spacing: 2px; color: color-mix(in srgb, var(--s-para) 22%, transparent); }
.rv-stars::before { content: "\2605\2605\2605\2605\2605"; }
.rv-stars::after { content: "\2605\2605\2605\2605\2605"; position: absolute; inset: 0 auto 0 0; width: var(--rv, 0%); overflow: hidden; white-space: nowrap; color: var(--rv-star, var(--s-accent)); }
.rv-stars--lg { font-size: 20px; }

.rv__top { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 48px; padding-bottom: 24px; border-bottom: 1px solid var(--s-border); }
.rv__sum { display: flex; align-items: center; gap: 14px; }
.rv__avg { margin: 0; font-size: 44px; font-weight: 700; line-height: 1; color: var(--s-heading); font-variant-numeric: tabular-nums; }
.rv__count { margin: 6px 0 0; font-size: 14px; color: var(--s-para); }
.rv__none { margin: 0; font-size: 15px; color: var(--s-para); }
.rv__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; min-width: 220px; flex: 0 1 320px; }
.rv__bars li { display: grid; grid-template-columns: 34px 1fr 28px; align-items: center; gap: 10px; font-size: 13px; color: var(--s-para); font-variant-numeric: tabular-nums; }
.rv__bar { height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--s-para) 14%, transparent); overflow: hidden; }
.rv__bar span { display: block; height: 100%; border-radius: inherit; background: var(--rv-star, var(--s-accent)); }
.rv__bar-c { text-align: right; }

.rv-btn { display: inline-flex; align-items: center; justify-content: center; padding: var(--sl-button-padding, 12px 22px); font-size: var(--sl-button-size, 15px); font-weight: var(--theme-button-weight, 600); border-radius: var(--s-radius); border: 1px solid var(--s-btn); background: var(--s-btn); color: var(--s-btn-text); cursor: pointer; list-style: none; transition: background-color 150ms ease, color 150ms ease; }
.rv-btn::-webkit-details-marker { display: none; }
.rv-btn:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.rv-btn--quiet { background: transparent; color: var(--s-heading); border-color: var(--s-border); }
.rv-btn--quiet:hover { background: color-mix(in srgb, var(--s-para) 8%, transparent); color: var(--s-heading); border-color: var(--s-border); }

.rv-note { display: none; margin: 20px 0 0; padding: 12px 16px; border-radius: var(--s-radius); background: color-mix(in srgb, var(--s-para) 8%, transparent); font-size: 14px; color: var(--s-heading); scroll-margin-top: 120px; }
.rv-note:target { display: block; }
.rv-note--error { border-left: 3px solid var(--s-heading); }

.rv-write { margin-top: 24px; }
.rv-write[open] > summary { margin-bottom: 20px; }
.rv-form { display: grid; gap: 14px; max-width: 640px; padding: 20px; border: 1px solid var(--s-border); border-radius: var(--s-radius); }
.rv-form__rate { border: 0; margin: 0; padding: 0; }
.rv-form__rate legend { font-size: 14px; font-weight: 600; color: var(--s-heading); margin-bottom: 6px; }
.rv-rate { display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; }
.rv-rate input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.rv-rate label { position: relative; width: 36px; height: 36px; cursor: pointer; font-size: 30px; line-height: 36px; text-align: center; color: color-mix(in srgb, var(--s-para) 25%, transparent); }
.rv-rate label::before { content: "\2605"; }
.rv-rate input:checked ~ label, .rv-rate label:hover, .rv-rate label:hover ~ label { color: var(--rv-star, var(--s-accent)); }
.rv-rate input:focus-visible + label { outline: 2px solid var(--s-heading); outline-offset: 2px; border-radius: 6px; }
.rv-form__f { display: grid; gap: 6px; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.rv-form__opt { font-weight: 400; color: var(--s-para); }
.rv-form input:not([type="radio"]):not([type="file"]), .rv-form textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; font: inherit; font-size: 16px; font-weight: 400; color: var(--s-text); background: var(--s-bg); border: 1px solid var(--s-border); border-radius: calc(var(--s-radius) * 0.6); }
.rv-form textarea { resize: vertical; min-height: 110px; line-height: 1.5; }
.rv-form input[type="file"] { font-size: 14px; font-weight: 400; color: var(--s-para); }
.rv-form__two { display: grid; gap: 14px; grid-template-columns: 1fr; }
@container (min-width: 560px) { .rv-form__two { grid-template-columns: 1fr 1fr; } }
.rv-form__note { margin: 0; font-size: 13px; color: var(--s-para); }
.rv-form .rv-btn { justify-self: start; }
.rv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

.rv__list { display: grid; gap: 0; margin-top: 8px; }
.rv__list--list .rv-card { padding: 24px 0; border-bottom: 1px solid var(--s-border); }
.rv__list--grid { gap: 20px; margin-top: 28px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .rv__list--grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .rv__list--grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.rv__list--grid .rv-card { padding: 20px; border: 1px solid var(--s-border); border-radius: var(--s-radius); }
.rv-card { min-width: 0; }
.rv-card__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.rv-card__date { font-size: 13px; color: var(--s-para); }
.rv-card__title { margin: 12px 0 0; font-size: 16px; font-weight: 600; color: var(--s-heading); overflow-wrap: anywhere; }
.rv-card__body { margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--s-para); white-space: pre-line; overflow-wrap: anywhere; }
.rv-card__photos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.rv-card__photos img { width: 72px; height: 72px; object-fit: cover; border-radius: calc(var(--s-radius) * 0.6); display: block; }
.rv-card__by { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 14px 0 0; font-size: 13px; color: var(--s-para); }
.rv-card__av { width: 28px; height: 28px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: color-mix(in srgb, var(--s-para) 12%, transparent); color: var(--s-heading); }
.rv-card__name { font-weight: 600; color: var(--s-heading); }
.rv-card__ver { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--s-para); }
.rv-card__ver::before { content: "\2713"; font-weight: 700; color: var(--s-heading); }
.rv-card__product { margin: 8px 0 0; font-size: 13px; color: var(--s-para); }
.rv-card__product a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }
.rv-card__reply { margin-top: 14px; padding: 12px 14px; border-left: 2px solid var(--s-border); background: color-mix(in srgb, var(--s-para) 5%, transparent); border-radius: 0 calc(var(--s-radius) * 0.6) calc(var(--s-radius) * 0.6) 0; }
.rv-card__reply-by { margin: 0; font-size: 13px; font-weight: 600; color: var(--s-heading); }
.rv-card__reply .rv-card__body { margin-top: 4px; font-size: 14px; }

.rv__bar span { background: var(--rv-bar, var(--rv-star, var(--s-accent))); }
.rv-card__ver { color: var(--rv-ver, var(--s-para)); }
.rv-card__ver::before { color: var(--rv-ver, var(--s-heading)); }

.rv__tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; }
.rv-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.rv-f { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
.rv-chip { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border: 1px solid var(--s-border); border-radius: 999px; font-size: 14px; color: var(--s-heading); cursor: pointer; font-variant-numeric: tabular-nums; transition: background-color 150ms ease, border-color 150ms ease; }
.rv-chip:hover { background: color-mix(in srgb, var(--s-para) 8%, transparent); }
.rv-f:checked + .rv-chip { background: var(--s-heading); border-color: var(--s-heading); color: var(--s-bg); }
.rv-f:focus-visible + .rv-chip { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.rv-sort { position: relative; }
.rv-sort__s { appearance: none; min-height: 36px; padding: 0 34px 0 12px; font: inherit; font-size: 14px; color: var(--s-heading); background: var(--s-bg); border: 1px solid var(--s-border); border-radius: calc(var(--s-radius) * 0.6); cursor: pointer; }
.rv-sort::after { content: ""; position: absolute; right: 13px; top: 50%; width: 6px; height: 6px; border-right: 1.5px solid var(--s-para); border-bottom: 1.5px solid var(--s-para); transform: translateY(-70%) rotate(45deg); pointer-events: none; }

.rv-card--more { display: none; }
.rv:has(.rv-more-t:checked) .rv-card--more,
.rv:has(.rv-f:not(.rv-f--0):checked) .rv-card--more,
.rv:has(.rv-sort__s option:checked:not([selected])) .rv-card--more { display: block; }
.rv-more-b { display: flex; width: max-content; margin: 20px auto 0; }
.rv-more-t:focus-visible + .rv-more-b { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.rv:has(.rv-more-t:checked) .rv-more-b,
.rv:has(.rv-f:not(.rv-f--0):checked) .rv-more-b,
.rv:has(.rv-sort__s option:checked:not([selected])) .rv-more-b { display: none; }
.rv:has(.rv-f--1:checked) .rv-card:not([data-rating="1"]),
.rv:has(.rv-f--2:checked) .rv-card:not([data-rating="2"]),
.rv:has(.rv-f--3:checked) .rv-card:not([data-rating="3"]),
.rv:has(.rv-f--4:checked) .rv-card:not([data-rating="4"]),
.rv:has(.rv-f--5:checked) .rv-card:not([data-rating="5"]) { display: none; }
.rv:has(.rv-sort__s option[value="featured"]:checked) .rv-card { order: var(--o-featured); }
.rv:has(.rv-sort__s option[value="newest"]:checked) .rv-card { order: var(--o-newest); }
.rv:has(.rv-sort__s option[value="highest"]:checked) .rv-card { order: var(--o-highest); }
.rv:has(.rv-sort__s option[value="lowest"]:checked) .rv-card { order: var(--o-lowest); }
.rv:has(.rv-sort__s option[value="photos"]:checked) .rv-card { order: var(--o-photos); }
.rv__nomatch { display: none; margin: 24px 0 0; font-size: 15px; color: var(--s-para); }
.rv:has(.rv-f--1:checked):not(:has(.rv-card[data-rating="1"])) .rv__nomatch,
.rv:has(.rv-f--2:checked):not(:has(.rv-card[data-rating="2"])) .rv__nomatch,
.rv:has(.rv-f--3:checked):not(:has(.rv-card[data-rating="3"])) .rv__nomatch,
.rv:has(.rv-f--4:checked):not(:has(.rv-card[data-rating="4"])) .rv__nomatch,
.rv:has(.rv-f--5:checked):not(:has(.rv-card[data-rating="5"])) .rv__nomatch { display: block; }
.rv__showing { margin: 16px 0 0; text-align: center; font-size: 13px; color: var(--s-para); }

.rv-ph { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: calc(var(--s-radius) * 0.6); }
.rv-ph:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.rv-lb { margin: auto; padding: 0; border: 0; background: transparent; max-width: min(92vw, 960px); max-height: 92vh; overflow: visible; }
.rv-lb::backdrop { background: var(--rv-scrim, rgb(0 0 0 / 0.72)); }
.rv-lb img { display: block; width: auto; height: auto; max-width: min(92vw, 960px); max-height: calc(92vh - 56px); object-fit: contain; border-radius: calc(var(--s-radius) * 0.6); }
.rv-card__photos .rv-lb img { width: auto; height: auto; }
.rv-lb__bar { display: flex; justify-content: space-between; gap: 16px; margin: 10px 0 0; font-size: 14px; }
.rv-lb__bar a, .rv-lb__bar button { color: var(--rv-scrim-text, #fff); background: none; border: 0; padding: 8px 0; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
.rv-card__videos { display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0 0; font-size: 14px; }
.rv-card__videos a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "reviews_product",
  "name": "Product reviews",
  "category": "reviews",
  "description": "Storelib Reviews: a product's rating, its reviews and a form to write one.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "toggle", "id": "show_summary", "label": "Show the rating", "default": true },
    { "type": "toggle", "id": "show_bars", "label": "Show reviews by stars", "default": true },
    { "type": "toggle", "id": "show_write", "label": "Show Write a review", "default": true, "info": "Only when Storelib Reviews lets anyone write. Otherwise buyers review from their email." },
    { "type": "range", "id": "per_page", "label": "Reviews before Show more", "default": 0, "min": 0, "max": 24, "step": 1, "info": "0 uses the number set in Storelib Reviews." },
    { "type": "toggle", "id": "show_tools", "label": "Show filter by stars and sort", "default": true },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "list", "options": [{ "label": "List", "value": "list" }, { "label": "Cards", "value": "grid" }] },
    { "type": "range", "id": "columns", "label": "Columns (cards)", "default": { "desktop": 2, "tablet": 2, "mobile": 1 }, "min": 1, "max": 3, "step": 1, "responsive": true },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "medium", "options": [{ "label": "Narrow", "value": "narrow" }, { "label": "Medium", "value": "medium" }, { "label": "Wide", "value": "wide" }, { "label": "Full", "value": "full" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "color", "id": "star_color", "label": "Star colour", "default": "", "info": "Empty uses the colour set in Storelib Reviews." },
    { "type": "color", "id": "bar_color", "label": "Rating bar colour", "default": "", "info": "Empty uses the star colour." },
    { "type": "color", "id": "verified_color", "label": "Verified buyer colour", "default": "" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Product reviews", "settings": {} }]
}
</schema>
