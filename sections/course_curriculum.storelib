{# ===========================================================================
   Course outline: what is inside, before anybody buys it

   The question a course page has to answer is "what will I actually get",
   and the answer is a list of modules with the lessons in each. Each module
   is a block; its lessons are typed one per line and drawn with the `lines`
   filter, so a creator writing the outline on a phone types a list rather
   than adding forty blocks.

   Modules open and close with <details>, like the FAQ: no script, keyboard
   operable, announced properly, and working before anything has loaded.
   =========================================================================== #}
<template>
<section class="s cc{% if settings.numbered %} cc--num{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %} cc__intro">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<ol class="cc__list">{% endif %}
      <li class="cc__item" data-block-id="{{ block.id }}">
        <details class="cc__module"{% if block.settings.open or forloop.first and settings.open_first %} open{% endif %}>
          <summary class="cc__head">
            {% if settings.numbered %}<span class="cc__num" aria-hidden="true">{{ forloop.index }}</span>{% endif %}
            <span class="cc__title">{{ block.settings.title }}</span>
            {% if block.settings.length %}<span class="cc__len">{{ block.settings.length }}</span>{% endif %}
            <span class="cc__mark" aria-hidden="true"></span>
          </summary>
          <div class="cc__body">
            {% if block.settings.summary %}<p class="cc__summary">{{ block.settings.summary }}</p>{% endif %}
            {% for line in block.settings.lessons | lines %}
              {% if forloop.first %}<ol class="cc__lessons">{% endif %}
              <li>{{ line }}</li>
              {% if forloop.last %}</ol>{% endif %}
            {% endfor %}
          </div>
        </details>
      </li>
      {% if forloop.last %}</ol>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="empty">Add modules in the sidebar</p>{% endif %}
    {% endfor %}

    {% if settings.button_text %}
      <div class="cc__cta {% if settings.align == 'center' %}cc__cta--center{% endif %}">
        <a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.7; }

.cc__intro { margin-bottom: 36px; }
.cc__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--s-border); }
.cc__item { border-bottom: 1px solid var(--s-border); }

/* Number, title, length, and the open mark, on one line from a phone up:
   the title takes what is left and wraps inside its own column. */
.cc__head {
  display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; column-gap: 14px;
  padding: 20px 2px; cursor: pointer; list-style: none;
}
.cc--num .cc__head { grid-template-columns: auto 1fr auto auto; }
.cc__head::-webkit-details-marker { display: none; }
.cc__head::marker { content: ""; }
.cc__num { min-width: 1.6em; font-size: 14px; font-weight: 600; color: var(--s-accent); font-variant-numeric: tabular-nums; }
.cc__title { font-size: 17px; font-weight: 600; line-height: 1.35; color: var(--s-heading); }
.cc__len { font-size: 13px; color: var(--s-para); white-space: nowrap; }
@container (max-width: 520px) {
  /* On a phone the length drops under the title rather than squeezing it. */
  .cc__head { grid-template-columns: 1fr auto; }
  .cc__len { grid-column: 1; grid-row: 2; margin-top: 4px; white-space: normal; }
  .cc__mark { grid-column: 2; grid-row: 1; }
  .cc--num .cc__head { grid-template-columns: auto 1fr auto; }
  .cc--num .cc__len { grid-column: 2; }
  .cc--num .cc__mark { grid-column: 3; }
}

/* A plus that becomes a minus, as in the FAQ. */
.cc__mark { position: relative; align-self: center; width: 14px; height: 14px; color: var(--s-heading); }
.cc__mark::before, .cc__mark::after {
  content: ""; position: absolute; inset: 0; margin: auto;
  background: currentColor; transition: transform 160ms ease, opacity 160ms ease;
}
.cc__mark::before { width: 14px; height: 1.5px; }
.cc__mark::after { width: 1.5px; height: 14px; }
.cc__module[open] .cc__mark::after { transform: scaleY(0); opacity: 0; }

.cc__body { padding: 0 2px 22px; }
/* Under the title, not under the number. 1.6em of the number's 14px, and the gap. */
.cc--num .cc__body { padding-left: calc(22.4px + 14px); }
.cc__summary { margin: 0 0 12px; font-size: 15px; line-height: 1.6; color: var(--s-para); }
.cc__lessons { margin: 0; padding-left: 1.3em; font-size: 15px; line-height: 1.5; color: var(--s-text); }
.cc__lessons li { padding: 5px 0; }
.cc__lessons li::marker { color: var(--s-para); font-variant-numeric: tabular-nums; }

.cc__cta { margin-top: 32px; }
.cc__cta--center { text-align: center; }

@media (prefers-reduced-motion: reduce) {
  .cc__mark::before, .cc__mark::after { transition: none; }
}

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "course_curriculum",
  "name": "Course Outline",
  "category": "content",
  "description": "The modules of a course and the lessons in each.",
  "version": "1.0.0",
  "icon": "graduation-cap",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the course" },
    { "type": "textarea", "id": "subheading", "label": "Supporting line", "default": "" },
    { "type": "radio", "id": "align", "label": "Heading sits", "default": "left",
      "options": [{ "label": "Left", "value": "left" }, { "label": "Centre", "value": "center" }] },
    { "type": "checkbox", "id": "numbered", "label": "Number the modules", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first module", "default": true },
    { "type": "text", "id": "button_text", "label": "Button", "default": "" },
    { "type": "product_picker", "id": "button_url", "label": "Button goes to", "default": "" },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "medium",
      "options": [{ "label": "Narrow", "value": "narrow" }, { "label": "Medium", "value": "medium" }, { "label": "Wide", "value": "wide" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Module",
      "limit": 30,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Module" },
        { "type": "text", "id": "length", "label": "Length", "default": "", "placeholder": "5 lessons, 40 min" },
        { "type": "textarea", "id": "summary", "label": "Summary", "default": "" },
        { "type": "textarea", "id": "lessons", "label": "Lessons", "default": "", "info": "One per line." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Course Outline",
      "blocks": [
        { "type": "module", "settings": { "title": "Materials and setting up", "length": "3 lessons, 25 min", "summary": "What to buy, and what you can do without.", "lessons": "Paper, brushes and paint\nA small table that works\nMixing your first palette" } },
        { "type": "module", "settings": { "title": "Washes", "length": "4 lessons, 40 min", "summary": "The one skill every painting leans on.", "lessons": "A flat wash\nA graded wash\nWet into wet\nRescuing a patchy wash" } },
        { "type": "module", "settings": { "title": "Colour", "length": "3 lessons, 35 min", "lessons": "Warm and cool\nMixing greens that look like plants\nColours that settle into the paper" } },
        { "type": "module", "settings": { "title": "One painting, start to finish", "length": "5 lessons, 70 min", "summary": "A harbour at dusk, painted alongside me.", "lessons": "Choosing a photo\nDrawing it out\nThe sky\nThe water and the boats\nThe last details" } }
      ]
    }
  ]
}
</schema>
