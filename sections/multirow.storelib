{# ===========================================================================
   Rows: a picture and some words, again and again

   For telling something in steps: how a piece is made, what happens in a
   session, three reasons in three pictures. Each row is a block with its
   own picture, heading, text and button, and the pictures swap sides row by
   row unless the creator turns that off.

   EACH PICTURE HAS A FOCUS. A row's photo is cropped to the section's shape,
   and a crop that cuts off somebody's face is the usual way a section like
   this goes wrong. The `focal_point` setting names its picture, so the editor
   lets the creator tap the part that matters, and the crop keeps it.
   =========================================================================== #}
<template>
<section class="s mr mr--{{ settings.first_side }}{% if settings.alternate %} mr--alt{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --mr-shape: {{ settings.shape }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading %}
      <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %} mr__intro">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="mr__rows">{% endif %}
      <div class="mr__row" data-block-id="{{ block.id }}">
        <div class="mr__media">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" loading="lazy" decoding="async" style="object-position: {{ block.settings.image_focus }};">
          {% else %}
            <div class="mr__placeholder" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="mr__copy">
          {% if block.settings.eyebrow %}<p class="s__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading %}
            {% if settings.heading %}<h3 class="mr__h">{{ block.settings.heading }}</h3>{% else %}<h2 class="mr__h">{{ block.settings.heading }}</h2>{% endif %}
          {% endif %}
          {% if block.settings.text %}<div class="rt">{{ block.settings.text | raw }}</div>{% endif %}
          {% if block.settings.button_text %}
            <div class="mr__btns"><a class="s__btn s__btn--secondary" href="{{ block.settings.button_url | default: '#' | url }}">{{ block.settings.button_text }}</a></div>
          {% endif %}
        </div>
      </div>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="empty">Add rows in the sidebar</p>{% endif %}
    {% endfor %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.7; }

.rt { font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.7); color: var(--s-para); }
.rt > :first-child { margin-top: 0; }
.rt > :last-child { margin-bottom: 0; }
.rt p { margin: 0 0 1em; }
.rt a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }
.rt ul, .rt ol { margin: 0 0 1em; padding-left: 1.35em; }
.rt li { margin: 0.35em 0; }

.mr__intro { margin-bottom: 48px; }
.mr__row { display: grid; gap: 24px; align-items: center; grid-template-columns: 1fr; }
.mr__row + .mr__row { margin-top: 56px; }
@container (min-width: 760px) {
  .mr__row { grid-template-columns: 1fr 1fr; gap: 56px; }
  .mr__row + .mr__row { margin-top: 88px; }
  /* Which side the first picture sits on, then every other row the other
     way when the rows alternate. `order` only: the reading order stays
     picture, then words, for a screen reader and for a phone. */
  .mr--right .mr__media { order: 2; }
  .mr--left.mr--alt .mr__row:nth-child(even) .mr__media { order: 2; }
  .mr--right.mr--alt .mr__row:nth-child(even) .mr__media { order: 0; }
}
.mr__media { overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); aspect-ratio: var(--mr-shape, 4 / 3); }
.mr__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.mr__placeholder { width: 100%; height: 100%; }
.mr__copy { max-width: 32rem; }
.mr__h {
  margin: 0 0 14px; font-size: 24px; line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; color: var(--s-heading);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.mr__btns { margin-top: 22px; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "multirow",
  "name": "Rows",
  "category": "content",
  "description": "Pictures and words in rows, swapping sides as they go.",
  "version": "1.0.0",
  "icon": "list",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "radio", "id": "align", "label": "Heading sits", "default": "left",
      "options": [{ "label": "Left", "value": "left" }, { "label": "Centre", "value": "center" }] },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "select", "id": "shape", "label": "Picture shape", "default": "4 / 3",
      "options": [{ "label": "Portrait", "value": "4 / 5" }, { "label": "Square", "value": "1 / 1" }, { "label": "Landscape", "value": "4 / 3" }, { "label": "Wide", "value": "16 / 9" }] },
    { "type": "radio", "id": "first_side", "label": "First picture", "default": "left",
      "options": [{ "label": "Left", "value": "left" }, { "label": "Right", "value": "right" }] },
    { "type": "checkbox", "id": "alternate", "label": "Swap sides row by row", "default": true },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "wide",
      "options": [{ "label": "Medium", "value": "medium" }, { "label": "Wide", "value": "wide" }, { "label": "Full", "value": "full" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture", "default": "" },
        { "type": "focal_point", "id": "image_focus", "label": "Keep in view", "image": "image", "default": "50% 50%" },
        { "type": "text", "id": "image_alt", "label": "Describe the picture", "default": "", "info": "For people who cannot see it." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A few sentences about this.</p>" },
        { "type": "text", "id": "button_text", "label": "Button", "default": "" },
        { "type": "url", "id": "button_url", "label": "Button link", "default": "" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Rows",
      "blocks": [
        { "type": "row", "settings": { "eyebrow": "Step one", "heading": "Thrown on the wheel", "text": "<p>Every cup starts as a pound of stoneware, centred and pulled up by hand. No two come out quite the same size, and that is the point.</p>" } },
        { "type": "row", "settings": { "eyebrow": "Step two", "heading": "Trimmed and handled", "text": "<p>A day later, when the clay is leather hard, the foot is trimmed and the handle is pulled and joined.</p>" } },
        { "type": "row", "settings": { "eyebrow": "Step three", "heading": "Glazed and fired twice", "text": "<p>A bisque firing, then the glaze, then a second firing to 1240°C. It takes a week from wheel to shelf.</p>", "button_text": "See the cups", "button_url": "/products" } }
      ]
    }
  ]
}
</schema>
