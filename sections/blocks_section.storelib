        },
        {
          "label": "End",
          "value": "end"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between blocks",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Text",
      "category": "content",
      "settings": {
        "max_width": "medium"
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Something worth saying"
          }
        },
        "text": {
          "type": "text"
        },
        "button": {
          "type": "button"
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ]
    },
    {
      "name": "Text, centred",
      "category": "content",
      "settings": {
        "max_width": "medium",
        "align": "center"
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Something worth saying",
            "align": "center"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "align": "center"
          }
        },
        "button": {
          "type": "button"
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ]
    },
    {
      "name": "Image with text",
      "category": "media",
      "blocks": {
        "row": {
          "type": "group",
          "settings": {
            "direction": "row",
            "gap": 40,
            "align": "center"
          },
          "blocks": {
            "image": {
              "type": "image",
              "settings": {
                "ratio": "portrait"
              }
            },
            "words": {
              "type": "group",
              "settings": {
                "gap": 16
              },
              "blocks": {
                "heading": {
                  "type": "heading",
                  "settings": {
                    "text": "Made by hand"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Tell the story behind what you sell, in a few lines.</p>"
                  }
                },
                "button": {
                  "type": "button"
                }
              },
              "block_order": [
                "heading",
                "text",
                "button"
              ]
            }
          },
          "block_order": [
            "image",
            "words"
          ]
        }
      },
      "block_order": [
        "row"
      ]
    },
    {
      "name": "Video with text",
      "category": "media",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "See it in use"
          }
        },
        "video": {
          "type": "video"
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>A minute is enough to show what a page of words cannot.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "video",
        "text"
      ]
    },
    {
      "name": "Three columns",
      "category": "content",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Why people come back"
          }
        },
        "columns": {
          "type": "group",
          "settings": {
            "direction": "row",
            "gap": 32
          },
          "blocks": {
            "one": {
              "type": "group",
              "settings": {
                "gap": 8
              },
              "blocks": {
                "h": {
                  "type": "heading",
                  "settings": {
                    "text": "Quick",
                    "size": "small",
                    "level": "h3"
                  }
                },
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Delivered the moment payment clears.</p>"
                  }
                }
              },
              "block_order": [
                "h",
                "t"
              ]
            },
            "two": {
              "type": "group",
              "settings": {
                "gap": 8
              },
              "blocks": {
                "h": {
                  "type": "heading",
                  "settings": {
                    "text": "Yours to keep",
                    "size": "small",
                    "level": "h3"
                  }
                },
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Every update arrives at no extra cost.</p>"
                  }
                }
              },
              "block_order": [
                "h",
                "t"
              ]
            },
            "three": {
              "type": "group",
              "settings": {
                "gap": 8
              },
              "blocks": {
                "h": {
                  "type": "heading",
