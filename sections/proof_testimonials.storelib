<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }}; --s-star: {{ settings.star_color | default: scheme.accent }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %} s__headblock">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="empty">Add what people said in the sidebar</p>{% endif %}
    {% else %}
      <div class="grid">
        {% for block in blocks %}
          <figure class="q" data-block-id="{{ block.id }}">
            {% if settings.show_stars %}<div class="stars" aria-label="{{ block.settings.rating }} {{ words.out_of_five }}">
                <span class="{% if block.settings.rating > 0 %}on{% endif %}">★</span><span class="{% if block.settings.rating > 1 %}on{% endif %}">★</span><span class="{% if block.settings.rating > 2 %}on{% endif %}">★</span><span class="{% if block.settings.rating > 3 %}on{% endif %}">★</span><span class="{% if block.settings.rating > 4 %}on{% endif %}">★</span>
              </div>{% endif %}
            <blockquote class="q__text">{{ block.settings.quote }}</blockquote>

              <div class="who">
                {% if block.settings.avatar %}
                  <img class="who__img" src="{{ block.settings.avatar | asset }}" alt="" loading="lazy" decoding="async">
                {% else %}
                  <span class="who__initial" aria-hidden="true">{{ block.settings.name | first }}</span>
                {% endif %}
                <div>
                  <div class="who__name">{{ block.settings.name }}</div>
                  {% if block.settings.role %}<div class="who__role">{{ block.settings.role }}</div>{% endif %}
                </div>
              </div>
          </figure>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.s__headblock { margin-bottom: 40px; }

.grid { display: grid; gap: 24px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.empty { margin: 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.55; }

.stars { display: flex; gap: 2px; margin-bottom: 12px; }
.stars span { font-size: 14px; line-height: 1; color: var(--s-border); }
.stars span.on { color: var(--s-star); }
.who { display: flex; align-items: center; gap: 10px; margin-top: 16px; }
.who__img { width: 36px; height: 36px; border-radius: 999px; object-fit: cover; flex: none; }
.who__initial { width: 36px; height: 36px; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--s-btn); color: var(--s-btn-text); flex: none; }
.who__name { font-size: 13px; font-weight: 600; color: var(--s-heading); }
.who__role { font-size: 12px; color: var(--s-para); opacity: 0.85; }

.q { margin: 0; padding: 22px; border: 1px solid var(--s-border); border-radius: var(--s-radius); }
.q__text { margin: 0; font-size: 15px; line-height: 1.6; color: var(--s-para); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "proof_testimonials",
  "name": "Testimonials Grid",
  "category": "social-proof",
  "description": "What people said, in a grid of cards.",
  "version": "1.0.0",
  "icon": "message-circle",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people say"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": { "desktop": 3, "tablet": 2, "mobile": 1 },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "toggle",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": ""
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "What they said",
          "default": "It turned up faster than I expected and looks better than the photos."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sam Okafor"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Where from",
          "default": "Bristol"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo",
          "default": ""
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "default": 5,
          "min": 0,
          "max": 5,
          "step": 1
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials Grid",
      "settings": {},
      "blocks": [
        {
          "id": "b1",
          "type": "quote",
          "settings": {
            "quote": "It turned up faster than I expected and looks better than the photos.",
            "name": "Sam Okafor",
            "role": "Bristol"
          }
        },
        {
          "id": "b2",
          "type": "quote",
          "settings": {
            "quote": "I have washed it a dozen times and it still holds its shape.",
            "name": "Lena Marsh",
            "role": "Leeds"
          }
        },
        {
          "id": "b3",
          "type": "quote",
          "settings": {
            "quote": "Asked a question at ten at night and had an answer by morning.",
            "name": "Tom Reilly",
            "role": "Cork"
          }
        }
      ]
    }
  ]
}
</schema>
