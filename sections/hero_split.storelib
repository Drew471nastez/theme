      "info": "Read aloud to people who cannot see it."
    },
    {
      "type": "radio",
      "id": "image_side",
      "label": "Image on",
      "default": "right",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Corners",
      "default": "default",
      "options": [
        {
          "label": "Theme",
          "value": "default"
        },
        {
          "label": "Rounded",
          "value": "round"
        },
        {
          "label": "Square",
          "value": "square"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
