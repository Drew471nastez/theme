<template>
<section class="s spot spot--{{ settings.image_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }} spot__in">
    <div class="spot__media" data-media>
      {# No picture of its own: the picture of the product the button goes to. #}
      {% if settings.image %}<img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="lazy" decoding="async">{% elsif settings.button_url.image %}<img src="{{ settings.button_url.image | asset }}" alt="{{ settings.image_alt | default: settings.button_url.title }}" loading="lazy" decoding="async">{% else %}<div class="spot__placeholder" aria-hidden="true"></div>{% endif %}
    </div>
    <div class="spot__copy">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {# The product chosen fills the name and the price. A typed name overrides the name; a typed price shows only with no product chosen, because checkout charges the product's own. #}
      {% if settings.heading or settings.button_url.title %}<h2 class="s__h">{{ settings.heading | default: settings.button_url.title }}</h2>{% elsif page.in_editor %}<p class="empty">Choose the product in the sidebar</p>{% endif %}
      {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      {% if settings.price or settings.button_url.price %}
        <p class="spot__price">{{ settings.button_url.price | default: settings.price }}{% if settings.button_url.title %}{% if settings.button_url.compare_price %}<s class="card__was">{{ settings.button_url.compare_price }}</s>{% endif %}{% elsif settings.compare_price %}<s class="card__was">{{ settings.compare_price }}</s>{% endif %}</p>
      {% endif %}
      {% if blocks.size > 0 %}
        <ul class="spot__points">
          {% for block in blocks %}<li data-block-id="{{ block.id }}"><strong>{{ block.settings.label }}</strong>{% if block.settings.text %} {{ block.settings.text }}{% endif %}</li>{% endfor %}
        </ul>
      {% endif %}
      {% if settings.button_text and settings.button_url %}
        <div class="s__btns"><a class="s__btn s__btn--primary" href="{{ settings.button_url.checkout_url | default: settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a></div>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.grid { display: grid; gap: 24px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.card { display: flex; flex-direction: column; }
.card__media { overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 14px 0 0; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__text { margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: var(--s-para); }
.card__price { margin: 8px 0 0; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.7; }
.card__link { position: absolute; inset: 0; }
.card__wrap { position: relative; }
.empty { margin: 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.55; }

.spot__in { display: grid; gap: 36px; align-items: center; grid-template-columns: 1fr; }
@container (min-width: 860px) { .spot__in { grid-template-columns: 1fr 1fr; gap: 56px; } .spot--left .spot__copy { order: 2; } }
.spot__media { overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); }
.spot__media img { display: block; width: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
.spot__placeholder { width: 100%; aspect-ratio: 4 / 3; }
.spot__copy { max-width: 32rem; }
.spot__price { margin: 16px 0 0; display: flex; align-items: baseline; gap: 10px; font-size: 24px; font-weight: 700; color: var(--s-heading); }
.spot__points { margin: 22px 0 0; padding: 0 0 0 0; list-style: none; display: grid; gap: 10px; border-top: 1px solid var(--s-border); padding-top: 18px; }
.spot__points li { font-size: 14px; line-height: 1.55; color: var(--s-para); }
.spot__points strong { color: var(--s-heading); font-weight: 600; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "product_spotlight",
  "name": "Product Spotlight",
  "category": "products",
  "description": "One product, given the whole row.",
  "version": "1.0.0",
  "icon": "zap",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "default": ""
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "This month's pick"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Name",
      "info": "Leave empty to use the product's.",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": ""
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "info": "Leave empty to use the product's.",
      "default": ""
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Was",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Buy it"
    },
    {
      "type": "product_picker",
      "id": "button_url",
      "label": "Product", "info": "The button opens this product's checkout.",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "radio",
      "id": "image_side",
      "label": "Photo on",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Materials"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% washed linen"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product Spotlight",
      "blocks": [
        {
          "id": "d1",
          "type": "point",
          "settings": {
            "label": "Materials",
            "text": "100% washed linen"
          }
        },
        {
          "id": "d2",
          "type": "point",
          "settings": {
            "label": "Made in",
            "text": "Porto, in small runs"
          }
        },
        {
          "id": "d3",
          "type": "point",
          "settings": {
            "label": "Delivery",
            "text": "2 to 4 working days"
          }
        }
      ]
    }
  ]
}
</schema>
