<template>
{% if settings.community.name or page.in_editor %}
<section class="s cc" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.community.name %}
      {% if settings.heading %}<h2 class="s__h cc__h">{{ settings.heading }}</h2>{% endif %}
      <div class="cc__card">
        {% if settings.show_cover and settings.community.image %}
          <a class="cc__cover" href="{{ settings.community | url }}" tabindex="-1" aria-hidden="true"><img src="{{ settings.community.image }}" alt="" loading="lazy" decoding="async"></a>
        {% endif %}
        <div class="cc__body">
          <div class="cc__id">
            {% if settings.community.logo %}<img class="cc__logo" src="{{ settings.community.logo }}" alt="" width="56" height="56" loading="lazy" decoding="async">{% else %}<span class="cc__logo cc__logo--blank" aria-hidden="true">{{ settings.community.name | first | upcase }}</span>{% endif %}
            <div class="cc__words">
              <h3 class="cc__name"><a href="{{ settings.community | url }}">{{ settings.community.name }}</a></h3>
              {% if settings.community.tagline %}<p class="cc__tag">{{ settings.community.tagline }}</p>{% endif %}
              {% if settings.show_stats %}
                <p class="cc__stats">{{ settings.community.members_label }}{% if settings.community.posts > 0 %} · {{ settings.community.posts }} {% if settings.community.posts == 1 %}post{% else %}posts{% endif %}{% endif %}{% if settings.community.events > 0 %} · {{ settings.community.events }} upcoming {% if settings.community.events == 1 %}event{% else %}events{% endif %}{% endif %}</p>
              {% endif %}
            </div>
          </div>
          <div class="cc__act">
            {% if settings.text %}<p class="cc__text">{{ settings.text }}</p>{% endif %}
            <a class="cc__btn" href="{{ settings.community | url }}">{{ settings.button_text | default: settings.community.join_label }}</a>
          </div>
        </div>
      </div>
    {% elsif page.in_editor %}
      <div class="cc__empty">
        <p class="cc__empty-h">Community</p>
        <p class="cc__empty-p">Choose one of your communities in this section's settings. It shows on your site once it is published and public.</p>
      </div>
    {% endif %}
  </div>
</section>
{% endif %}
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__h {
  margin: 0 0 24px;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.cc__card { border: 1px solid var(--s-border); border-radius: calc(var(--s-radius) + 6px); overflow: hidden; }
.cc__cover { display: block; aspect-ratio: 3 / 1; overflow: hidden; background: color-mix(in srgb, var(--s-text) 6%, transparent); }
.cc__cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
.cc__body { display: flex; flex-direction: column; gap: 20px; padding: 20px; }
.cc__id { display: flex; align-items: center; gap: 14px; min-width: 0; }
.cc__logo { flex: none; width: 56px; height: 56px; border-radius: 14px; object-fit: cover; border: 1px solid var(--s-border); }
.cc__logo--blank { display: inline-flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; color: var(--s-heading); background: color-mix(in srgb, var(--s-text) 8%, transparent); }
.cc__words { min-width: 0; }
.cc__name { margin: 0; font-size: 20px; line-height: 1.3; font-weight: 650; color: var(--s-heading); }
.cc__name a { color: inherit; text-decoration: none; }
.cc__name a:hover { text-decoration: underline; text-underline-offset: 3px; }
.cc__tag { margin: 4px 0 0; font-size: 15px; line-height: 1.5; color: var(--s-para); }
.cc__stats { margin: 6px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.85; font-variant-numeric: tabular-nums; }
.cc__act { display: flex; flex-direction: column; gap: 12px; }
.cc__text { margin: 0; font-size: 15px; line-height: 1.6; color: var(--s-para); }
.cc__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 46px;
  padding: 0 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid var(--s-btn); background: var(--s-btn); color: var(--s-btn-text);
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.cc__btn:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
@container (min-width: 640px) {
  .cc__cover { aspect-ratio: 4 / 1; }
  .cc__body { flex-direction: row; align-items: center; justify-content: space-between; gap: 32px; padding: 28px 32px; }
  .cc__act { flex: none; align-items: flex-end; max-width: 300px; text-align: right; }
}
.cc__empty { border: 2px dashed var(--s-border); border-radius: calc(var(--s-radius) + 6px); padding: 36px 24px; text-align: center; }
.cc__empty-h { margin: 0; font-size: 16px; font-weight: 600; color: var(--s-heading); }
.cc__empty-p { margin: 6px auto 0; max-width: 28rem; font-size: 14px; line-height: 1.5; color: var(--s-para); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "community_card",
  "name": "Community",
  "category": "social-proof",
  "description": "One of your communities: its name, members and a button to join.",
  "version": "1.0.0",
  "icon": "users",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "community_picker",
      "id": "community",
      "label": "Community",
      "info": "One of your communities. It shows once it is published and public."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the community"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Line beside the button",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "",
      "placeholder": "Join for free"
    },
    {
      "type": "toggle",
      "id": "show_cover",
      "label": "Cover picture",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_stats",
      "label": "Members and events counts",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "medium",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Community"
    }
  ]
}
</schema>
