<template>
<section class="fw fw-ic" data-scheme="{{ settings.color_scheme }}" data-btn="{{ theme.buttons.style }}" data-btn-shape="{{ theme.buttons.shape }}" data-btn-hover="{{ theme.buttons.hover }}" data-btn-shadow="{{ theme.buttons.shadow }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.accent }};--fw-button:{{ scheme.primary_btn_bg | default: scheme.primary_button_background }};--fw-button-text:{{ scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-border:{{ scheme.primary_btn_border | default: scheme.primary_button_border }};--fw-button-hover:{{ scheme.primary_btn_hover_bg | default: scheme.primary_button_hover_background }};--fw-button-hover-text:{{ scheme.primary_btn_hover_text | default: scheme.primary_button_hover_text | default: scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-2:{{ scheme.secondary_btn_bg | default: scheme.secondary_button_background }};--fw-button-2-text:{{ scheme.secondary_btn_text | default: scheme.secondary_button_text }};--fw-button-2-border:{{ scheme.secondary_btn_border | default: scheme.secondary_button_border }};--fw-button-2-hover:{{ scheme.secondary_btn_hover_bg | default: scheme.secondary_button_hover_background }};--fw-button-2-hover-text:{{ scheme.secondary_btn_hover_text | default: scheme.secondary_button_hover_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner"><div class="fw-ic__intro">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}</div>
 <div class="fw-ic__area" style="--split:50%" data-media>
  <div class="fw-ic__picture fw-ic__picture--before">{% if settings.before_image %}<img src="{{ settings.before_image | asset }}" alt="{{ settings.before_alt }}" loading="lazy">{% else %}<span class="fw-ic__empty">{{ settings.before_label }}</span>{% endif %}</div>
  <div class="fw-ic__picture fw-ic__picture--after">{% if settings.after_image %}<img src="{{ settings.after_image | asset }}" alt="{{ settings.after_alt }}" loading="lazy">{% else %}<span class="fw-ic__empty">{{ settings.after_label }}</span>{% endif %}</div>
  <div class="fw-ic__line" aria-hidden="true"><span>↔</span></div>
  <span class="fw-ic__label fw-ic__label--left">{{ settings.before_label }}</span><span class="fw-ic__label fw-ic__label--right">{{ settings.after_label }}</span>
  <input type="range" min="0" max="100" value="50" step="1" aria-label="Move to compare before and after">
 </div>
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a:not(.fw__action){color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:calc(var(--fw-top) * var(--theme-spacing-scale,1)) var(--theme-padding-x, 24px) calc(var(--fw-bottom) * var(--theme-spacing-scale,1));margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-family:var(--sl-caption-font, var(--theme-font-accent, var(--theme-font-body))),sans-serif;font-size:var(--sl-caption-size, var(--type-caption-size, 11px));font-weight:var(--sl-caption-weight, var(--type-caption-weight, 700));letter-spacing:var(--sl-caption-tracking, var(--type-caption-tracking, .14em));text-transform:var(--sl-caption-transform, var(--type-caption-transform, uppercase));line-height:var(--type-caption-line-height, 1.4);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font, var(--type-h2-font, var(--theme-font-heading))),sans-serif;font-size:var(--section-heading-size, var(--type-h2-size, clamp(30px, 4.2cqi, 56px)));font-weight:var(--section-heading-weight, var(--type-h2-weight, 650));line-height:var(--section-heading-line-height, var(--type-h2-line-height, 1.12));letter-spacing:var(--section-heading-tracking, var(--type-h2-tracking, -.04em));text-transform:var(--section-heading-transform, var(--type-h2-transform, none));overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--section-body-font, var(--type-body-font, var(--theme-font-body))),sans-serif;font-size:var(--section-text-size, var(--type-body-size, 16px));line-height:var(--section-text-line-height, var(--type-body-line-height, 1.7));font-weight:var(--type-body-weight, 400);letter-spacing:var(--type-body-tracking, 0);color:var(--fw-muted);}
.fw a.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding, 12px 22px);text-decoration:none;border-radius:var(--theme-button-radius, var(--fw-radius));font-family:var(--type-button-font, var(--theme-font-body)),sans-serif;font-weight:var(--theme-button-weight, var(--type-button-weight, 600));font-size:var(--sl-button-size, var(--type-button-size, 15px));line-height:var(--sl-button-line-height, var(--type-button-line-height, 1.2));letter-spacing:var(--type-button-tracking, 0);text-transform:var(--type-button-transform, none);background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));border:1px solid var(--fw-button-border, var(--fw-button, var(--scheme-button-primary-border)));box-shadow:var(--sl-btn-shadow, none);transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,box-shadow 180ms ease,transform 220ms cubic-bezier(.22,1,.36,1);}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:var(--fw-button, var(--scheme-button-primary));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:transparent;box-shadow:none;}
.fw a.fw__action:hover{background:var(--fw-button-hover, var(--fw-button, var(--scheme-button-primary-hover)));color:var(--fw-button-hover-text, var(--fw-button-text, var(--scheme-button-primary-hover-text)));border-color:var(--fw-button-hover, var(--fw-button));}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary):hover{background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary):hover{background:color-mix(in srgb, var(--fw-button, var(--scheme-button-primary)) 12%, transparent);color:var(--fw-button, var(--scheme-button-primary));}
.fw a.fw__action.fw__action--secondary{background:var(--fw-button-2, var(--scheme-button-secondary, transparent));color:var(--fw-button-2-text, var(--scheme-button-secondary-text, var(--fw-title)));border-color:var(--fw-button-2-border, var(--scheme-button-secondary-border, var(--fw-line)));}
.fw a.fw__action.fw__action--secondary:hover{background:var(--fw-button-2-hover, var(--fw-button-2, var(--scheme-button-secondary-hover, transparent)));color:var(--fw-button-2-hover-text, var(--fw-button-2-text, var(--scheme-button-secondary-hover-text, var(--fw-title))));}
.fw[data-btn-shape="square"] .fw__action{border-radius:0;}
.fw[data-btn-shape="pill"] .fw__action{border-radius:999px;}
.fw[data-btn-shadow="true"][data-btn="filled"] .fw__action:not(.fw__action--secondary){box-shadow:0 8px 22px color-mix(in srgb, var(--scheme-button-primary, var(--fw-button)) 24%, transparent);}
.fw[data-btn-hover="lift"] .fw__action:hover{transform:translateY(-2px);}
.fw[data-btn-hover="scale"] .fw__action:hover{transform:scale(1.03);}
.fw[data-btn-hover="none"] .fw__action,.fw[data-btn-hover="none"] .fw__action:hover{transition:none;transform:none;}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-ic__intro{max-width:680px;text-align:center;margin:0 auto 32px}.fw-ic__intro .fw__lede{margin-inline:auto}.fw-ic__area{isolation:isolate;position:relative;max-width:1000px;margin-inline:auto;aspect-ratio:1.9;min-height:270px;overflow:hidden;border-radius:var(--sl-image-radius, var(--fw-radius));background:var(--scheme-background-secondary, var(--fw-line))}.fw-ic__picture{position:absolute;inset:0;overflow:hidden}.fw-ic__picture>img{width:100%;height:100%;object-fit:cover}.fw-ic__picture--before{background:linear-gradient(140deg, var(--fw-line), var(--scheme-background-secondary, var(--fw-bg)))}.fw-ic__picture--after{clip-path:inset(0 0 0 var(--split));background:linear-gradient(130deg, var(--fw-accent), var(--fw-bg))}.fw-ic__empty{display:grid;place-items:center;height:100%;font-family:var(--type-h2-font, var(--theme-font-heading)),sans-serif;font-size:var(--type-h2-size, clamp(30px, 4vw, 60px));color:var(--fw-title);font-weight:var(--type-h2-weight, 650);letter-spacing:var(--type-h2-tracking, -.04em);opacity:.72}.fw-ic__line{position:absolute;left:var(--split);top:0;bottom:0;width:2px;background:var(--scheme-background, var(--fw-bg));transform:translateX(-1px);pointer-events:none}.fw-ic__line span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:grid;place-items:center;background:var(--scheme-background, var(--fw-bg));color:var(--fw-title);height:50px;width:50px;border-radius:50%;box-shadow:0 4px 24px color-mix(in srgb, var(--fw-title) 18%, transparent)}.fw-ic__label{position:absolute;z-index:1;top:20px;padding:8px 14px;border-radius:var(--theme-radius,100px);background:var(--scheme-background,var(--fw-bg));color:var(--scheme-heading,var(--fw-title));font-family:var(--sl-caption-font,var(--theme-font-body)),sans-serif;font-size:var(--sl-caption-size,12px);font-weight:var(--sl-caption-weight,700);letter-spacing:var(--sl-caption-tracking,0);text-transform:var(--sl-caption-transform,none);pointer-events:none}.fw-ic__label--left{left:20px}.fw-ic__label--right{right:20px}.fw-ic__area input{position:absolute;inset:0;z-index:4;width:100%;height:100%;opacity:0;cursor:ew-resize}
@container(max-width:600px){.fw-ic__area{aspect-ratio:1.15;min-height:250px}.fw-ic__label{top:12px}.fw-ic__label--left{left:12px}.fw-ic__label--right{right:12px}}
</style>

<script>
// Each section script receives only its own `root` from Storelib's sandbox.
// Never access the page document or attach global event handlers.
const area = root.querySelector('.fw-ic__area');
const slider = root.querySelector('.fw-ic__area input[type="range"]');

if (area && slider) {
  const updateComparison = () => {
    const position = Number(slider.value);
    if (!Number.isFinite(position)) return;
    const percent = Math.min(100, Math.max(0, position));
    area.style.setProperty('--split', percent + '%');
  };

  slider.addEventListener('input', updateComparison);
  slider.addEventListener('change', updateComparison);
  updateComparison();
}
</script>

<schema>
