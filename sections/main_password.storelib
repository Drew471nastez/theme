<template>
<section class="s{% if settings.fill_screen %} s--fill{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --pw-logo: {{ settings.logo_width }}px;">
  <div class="s__in pw pw--{{ settings.text_align }}">
    {# The page a website shows until it opens, or while its owner keeps it
       behind a password (Website Settings, Publishing). The store's logo or
       name, a line about opening, a box to be told when it does, and the
       password for the people the owner gave it to. #}
    <div class="pw__brand">
      {% if settings.show_logo and shop.logo %}
        <img class="pw__logo" src="{{ shop.logo | asset }}" alt="{{ shop.name }}" loading="eager" decoding="async">
      {% else %}
        <p class="pw__name">{{ shop.name }}</p>
      {% endif %}
    </div>

    <h1 class="s__h">{{ settings.heading }}</h1>
    {% if settings.text %}<p class="s__sub">{{ settings.text }}</p>{% endif %}

    {% if settings.show_signup %}
      {# Joins the creator's Subscribers, like every email box on the site.
         In the builder it only shows the line below. #}
      <form class="pw__form" data-storelib-form="subscribe">
        <label class="sr" for="{{ section.id }}-email">{{ settings.signup_label }}</label>
        <div class="pw__row">
          <input class="pw__input" id="{{ section.id }}-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="{{ settings.email_placeholder }}" required>
          <button class="pw__btn pw__btn--primary" type="submit">{{ settings.signup_button }}</button>
        </div>
        <p class="pw__done" data-storelib-success hidden>{{ settings.signup_success }}</p>
      </form>
    {% endif %}

    {# The password stays folded until it is asked for, the way Shopify's
       does: most visitors are here to be told when the site opens, and a
       second form in their way says the opposite. A wrong password comes
       back with it open, so the alert is beside the field. #}
    <div class="pw__enter">
      <details class="pw__gate"{% if page.notice %} open{% endif %}>
        <summary class="pw__reveal">{{ settings.password_heading | default: "Enter using password" }}</summary>
        {% if page.notice %}<p class="pw__notice" role="alert">{{ page.notice }}</p>{% endif %}
        <form class="pw__form pw__form--tight" method="post" action="{{ routes.password_enter_url }}" data-storelib-form="native">
          <label class="sr" for="{{ section.id }}-password">{{ settings.password_label }}</label>
          <div class="pw__row">
            <input class="pw__input" id="{{ section.id }}-password" name="password" type="password" autocomplete="current-password" maxlength="100" placeholder="{{ settings.password_placeholder }}" required>
            <input type="hidden" name="return" value="{{ page.return_to }}">
            <button class="pw__btn pw__btn--secondary" type="submit">{{ settings.password_button }}</button>
          </div>
        </form>
      </details>
      {% if settings.show_owner_link and page.owner_url %}
        <p class="pw__owner"><a class="pw__link" href="{{ page.owner_url | url }}">{{ settings.owner_label }}</a></p>
      {% elsif settings.show_owner_link and page.in_editor %}
        <p class="pw__owner"><span class="pw__link">{{ settings.owner_label }}</span></p>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s--fill { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; }
.s__in {
  box-sizing: border-box; width: 100%;
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.pw { max-width: 520px; }
.pw--center { text-align: center; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  overflow-wrap: anywhere;
}
.s__sub { margin: 12px 0 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); overflow-wrap: anywhere; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.pw__brand { margin: 0 0 28px; }
.pw__logo { display: inline-block; width: var(--pw-logo); max-width: 100%; height: auto; }
.pw__name { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: 0.02em; color: var(--s-heading); }

.pw__form { margin-top: 28px; text-align: left; }
.pw__form--tight { margin-top: 12px; }
.pw__row { display: flex; flex-direction: column; gap: 10px; }
@container (min-width: 440px) { .pw__row { flex-direction: row; } }
/* 16px text, so a phone does not zoom the page when the field takes focus. */
.pw__input {
  box-sizing: border-box; flex: 1 1 auto; min-width: 0; width: 100%; min-height: 48px; padding: 12px 14px;
  font: inherit; font-size: 16px; color: var(--s-text); background: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: var(--s-radius);
  -webkit-appearance: none; appearance: none;
}
.pw__input::placeholder { color: var(--s-para); opacity: 0.75; }
.pw__input:focus { outline: 2px solid var(--s-heading); outline-offset: 1px; border-color: var(--s-heading); }
.pw__btn {
  display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 48px; padding: 12px 22px;
  font: inherit; font-size: 15px; font-weight: 600; white-space: nowrap;
  border-radius: var(--s-radius); border: 1px solid transparent; cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.pw__btn:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.pw__btn:disabled { opacity: 0.6; cursor: default; }
.pw__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.pw__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.pw__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.pw__done { margin: 0; font-size: 16px; line-height: 1.6; color: var(--s-heading); }
.pw--center .pw__done { text-align: center; }

.pw__enter { margin-top: 36px; display: flex; flex-direction: column; align-items: flex-start; }
.pw--center .pw__enter { align-items: center; }
.pw__gate { width: 100%; }
.pw__reveal {
  display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 2px;
  list-style: none; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--s-heading);
  border-radius: var(--s-radius);
}
.pw__reveal::-webkit-details-marker { display: none; }
.pw__reveal::after {
  content: ""; width: 7px; height: 7px; margin-top: -4px;
  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
  rotate: 45deg; transition: rotate 200ms ease, margin 200ms ease;
}
.pw__gate[open] > .pw__reveal::after { rotate: -135deg; margin-top: 4px; }
.pw__reveal:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.pw--center .pw__gate { text-align: center; }
.pw__gate[open] > .pw__form, .pw__gate[open] > .pw__notice { animation: pw-in 240ms cubic-bezier(0.16, 1, 0.3, 1) both; }
@keyframes pw-in { from { opacity: 0; transform: translateY(-4px); } }
.pw__label { margin: 0; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.pw__notice {
  margin: 12px 0 0; padding: 12px 14px; font-size: 14px; line-height: 1.5; text-align: left;
  color: var(--s-heading); border: 1px solid var(--s-border); border-radius: var(--s-radius);
}
.pw__owner { margin: 4px 0 0; font-size: 14px; }
.pw__link { display: inline-flex; align-items: center; min-height: 44px; color: var(--s-para); text-decoration: underline; text-underline-offset: 4px; }
.pw__link:hover { color: var(--s-heading); }
@media (prefers-reduced-motion: reduce) { .pw__btn, .pw__reveal::after { transition: none; } .pw__gate[open] > .pw__form, .pw__gate[open] > .pw__notice { animation: none; } }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "main_password",
  "name": "Password page",
  "category": "account",
  "description": "What visitors see while your website asks for a password: your logo, a line about opening, a box to be told when you do, and the password field.",
  "version": "1.0.0",
  "icon": "lock",
  "allowed_templates": ["page.password"],
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "toggle", "id": "show_logo", "label": "Show your logo", "default": true, "info": "The logo from Theme settings. Without one, your store name shows." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "default": 120, "min": 40, "max": 280, "step": 4, "unit": "px" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "textarea", "id": "text", "label": "Line under the heading", "default": "We are getting ready. Leave your email and we will tell you when we open." },
    { "type": "header", "id": "hdr_signup", "label": "Email sign up" },
    { "type": "toggle", "id": "show_signup", "label": "Ask for an email", "default": true, "info": "Sign ups join your Subscribers." },
    { "type": "text", "id": "signup_label", "label": "Field name for screen readers", "default": "Email" },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "signup_button", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "signup_success", "label": "After signing up", "default": "Thanks. We will email you when we open." },
    { "type": "header", "id": "hdr_password", "label": "Password" },
    { "type": "text", "id": "password_heading", "label": "Link that shows the field", "default": "Enter using password" },
    { "type": "text", "id": "password_label", "label": "Field name for screen readers", "default": "Password" },
    { "type": "text", "id": "password_placeholder", "label": "Placeholder", "default": "Password" },
    { "type": "text", "id": "password_button", "label": "Button", "default": "Enter" },
    { "type": "toggle", "id": "show_owner_link", "label": "Show the owner's way in", "default": true },
    { "type": "text", "id": "owner_label", "label": "Owner link", "default": "Are you the owner? Enter here" },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    {
      "type": "radio", "id": "text_align", "label": "Alignment", "default": "center",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" }
      ]
    },
    { "type": "toggle", "id": "fill_screen", "label": "Fill the screen", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [
    { "name": "Password page", "settings": {} }
  ]
}
</schema>
