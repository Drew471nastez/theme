<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="s__in s__in--{{ settings.max_width }} wl wl--{{ settings.card_style }} wl--{{ settings.text_align }}">
    <h1 class="s__h">{{ settings.heading }}</h1>

    {# Drawn with what the server knew: the account's list, or the list this
       browser keeps. A heart pressed here takes the product out, and the page
       hides its card without a reload (StorelibSection). The empty line is
       always drawn, so the page can show it when the last card goes. #}
    {% if wishlist.count > 0 %}
      <div class="grid">
        {% for item in wishlist.items %}
        <article class="card" data-card="product" data-storelib-wishlist-card="{{ item.id }}">
          <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
            {% if item.image %}<img src="{{ item.image | asset }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% endif %}
            {# Theme settings › Product cards and Badges reach a saved item as they reach the shop's cards. #}{% if item.tag or theme.badges.sale and item.compare_price %}<span class="badges" data-badges>{% if theme.badges.sale and item.compare_price %}<span class="tag" data-badge="sale">{{ theme.badges.sale_text }}</span>{% endif %}{% if item.tag %}<span class="tag" data-badge="{% if item.tag == 'Sold out' %}soldout{% else %}tag{% endif %}">{{ item.tag }}</span>{% endif %}</span>{% endif %}
            <button type="button" class="heart" data-storelib-wishlist="{{ item.id }}" aria-pressed="true" aria-label="{{ words.remove_saved }}: {{ item.title }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button>
          </div>
          <h2 class="card__title">{{ item.title }}</h2>
          {% if settings.show_price and item.price %}
            <p class="card__price">{{ item.price }}{% if item.compare_price %}<s class="card__was">{{ item.compare_price }}</s>{% endif %}</p>
          {% endif %}
          {% if item.url %}<a class="card__link" href="{{ item.url | url }}"><span class="sr">{{ item.title }}</span></a>{% endif %}
        </article>
        {% endfor %}
      </div>
      <div class="empty" data-storelib-wishlist-empty hidden>
        <p class="empty__text">{{ settings.empty_text }}</p>
        <a class="empty__link" href="{{ routes.products_url }}">{{ settings.shop_link }}</a>
      </div>
    {% else %}
      <div class="empty" data-storelib-wishlist-empty>
        <p class="empty__text">{{ settings.empty_text }}</p>
        <a class="empty__link" href="{{ routes.products_url }}">{{ settings.shop_link }}</a>
      </div>
    {% endif %}

    {% if settings.show_signin_note and not wishlist.signed_in %}
      <p class="note">{{ settings.signin_note }} <a class="note__link" href="{{ routes.account_login_url }}?return=%2Fwishlist">{{ settings.signin_link }}</a></p>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}

.grid { display: grid; gap: 24px; margin-top: 32px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.card { position: relative; display: flex; flex-direction: column; }
/* The card's look (Card style): the picture and words on the page, a line around both, or both on a tint. */
.wl--bordered .card { padding: 10px 10px 14px; border: 1px solid var(--s-border); border-radius: var(--s-radius); }
.wl--filled .card { padding: 10px 10px 14px; background: color-mix(in srgb, var(--s-border) 45%, var(--s-bg)); border-radius: var(--s-radius); }
.wl--center .s__h, .wl--center .card__title, .wl--center .empty, .wl--center .note { text-align: center; }
.wl--center .card__price { justify-content: center; }
.card[hidden] { display: none; }
.card__media { position: relative; overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 14px 0 0; font-size: 15px; font-weight: 600; line-height: 1.35; color: var(--s-heading); }
.card__price { margin: 8px 0 0; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.7; }
.card__link { position: absolute; inset: 0; }
.badges { position: absolute; top: 10px; left: 10px; z-index: 1; display: flex; flex-wrap: wrap; gap: 6px; max-width: calc(100% - 56px); }
.tag { padding: 4px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; background: var(--s-btn); color: var(--s-btn-text); }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

/* The heart sits over the card's link, above it, so pressing it saves
   rather than opens. Filled when the product is saved. */
.heart {
  position: absolute; top: 10px; right: 10px; z-index: 2;
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; padding: 0;
  color: var(--s-heading); background: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: 999px;
  cursor: pointer; -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease;
}
.heart svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; transition: fill 150ms ease; }
.heart[aria-pressed="true"] svg { fill: currentColor; }
.heart:active { transform: scale(0.92); }
.heart:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }

.empty { margin-top: 28px; }
.empty[hidden] { display: none; }
.empty__text { margin: 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.empty__link { display: inline-block; margin-top: 10px; font-size: 15px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 4px; }
.note { margin: 36px 0 0; font-size: 14px; line-height: 1.6; color: var(--s-para); }
.note__link { color: var(--s-heading); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .heart, .heart svg { transition: none; } }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "main_wishlist",
  "name": "Wishlist",
  "category": "account",
  "description": "The products a visitor saved with the heart. Kept in their browser, or in their customer account once they sign in.",
  "version": "1.0.0",
  "icon": "heart",
  "allowed_templates": ["page.wishlist"],
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wishlist" },
    { "type": "text", "id": "empty_text", "label": "When nothing is saved", "default": "Nothing saved yet. Tap the heart on a product to keep it here." },
    { "type": "text", "id": "shop_link", "label": "Link to the shop", "default": "Browse the shop" },
    { "type": "toggle", "id": "show_signin_note", "label": "Suggest signing in", "default": true, "info": "Shown to visitors who are not signed in." },
    { "type": "text", "id": "signin_note", "label": "Suggestion", "default": "Saved items stay in this browser." },
    { "type": "text", "id": "signin_link", "label": "Link", "default": "Sign in to keep them on every device." },
    { "type": "header", "id": "hdr_cards", "label": "Cards" },
    { "type": "toggle", "id": "show_price", "label": "Show price", "default": true },
    {
      "type": "select", "id": "card_style", "label": "Card style", "default": "plain",
      "options": [
        { "label": "Plain", "value": "plain" },
        { "label": "Outlined", "value": "bordered" },
        { "label": "Filled", "value": "filled" }
      ]
    },
    {
      "type": "range", "id": "columns", "label": "Columns",
      "default": { "desktop": 4, "tablet": 3, "mobile": 2 },
      "min": 1, "max": 5, "step": 1, "responsive": true
    },
    {
      "type": "select", "id": "shape", "label": "Image shape", "default": "1 / 1",
      "options": [
        { "label": "Square", "value": "1 / 1" },
        { "label": "Portrait", "value": "3 / 4" },
        { "label": "Landscape", "value": "4 / 3" }
      ]
    },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    {
      "type": "radio", "id": "text_align", "label": "Alignment", "default": "left",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" }
      ]
    },
    {
      "type": "select", "id": "max_width", "label": "Width", "default": "wide",
      "options": [
        { "label": "Narrow", "value": "narrow" },
        { "label": "Medium", "value": "medium" },
        { "label": "Wide", "value": "wide" },
        { "label": "Full", "value": "full" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 88, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [
    { "name": "Wishlist", "settings": {} }
  ]
}
</schema>
