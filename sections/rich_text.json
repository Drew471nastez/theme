{
  "type": "rich_text",
  "name": "Rich text",
  "description": "A text block with heading, body copy, and optional CTA",
  "supports_typography_overrides": false,
  "icon": "type",
  "category": "content",
  "fields": [
    {
      "id": "hdr_content",
      "label": "Content",
      "type": "header"
    },
    {
      "id": "eyebrow",
      "label": "Eyebrow text",
      "type": "text",
      "placeholder": "Our story"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "placeholder": "About us"
    },
    {
      "id": "body",
      "label": "Body text",
      "type": "richtext",
      "placeholder": "Write your story..."
    },
    {
      "id": "hdr_button",
      "label": "Button",
      "type": "header"
    },
    {
      "id": "button_text",
      "label": "Button text",
      "type": "text",
      "placeholder": "Read more"
    },
    {
      "id": "button_url",
      "label": "Button URL",
      "type": "link"
    },
    {
      "id": "button_style",
      "label": "Button style",
      "type": "radio",
      "default": "filled",
      "options": [
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Ghost",
          "value": "ghost"
        }
      ]
    },
    {
      "id": "button_color",
      "label": "Button color",
      "type": "color",
      "default": ""
    },
    {
      "id": "button_text_color",
      "label": "Button text color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "button_border_radius",
      "label": "Button radius",
      "type": "range",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "id": "hdr_style",
      "label": "Style",
      "type": "header"
    },
    {
      "id": "color_scheme",
      "label": "Color scheme",
      "type": "select",
      "default": "white",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Soft",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Brand",
          "value": "black"
        },
        {
          "label": "Accent",
          "value": "highlight"
        }
      ]
    },
    {
      "id": "bg_color",
      "label": "Background",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "id": "text_color",
      "label": "Text color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "id": "font_size_heading",
      "label": "Heading font size",
      "type": "range",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "id": "hdr_layout",
      "label": "Layout",
      "type": "header"
    },
    {
      "id": "alignment",
      "label": "Alignment",
      "type": "radio",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "id": "max_width",
      "label": "Content width",
      "type": "select",
      "default": "medium",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Centered about section",
      "settings": {
        "eyebrow": "Our mission",
        "heading": "Built for creators, by creators",
        "body": "<p>We believe great tools should be beautiful, fast, and effortless to use. That's why we built this platform from the ground up with you in mind.</p>",
        "button_text": "Meet the team",
        "button_url": "/about",
        "button_style": "filled",
        "alignment": "center",
        "max_width": "narrow",
        "padding_top": 80,
        "padding_bottom": 80,
        "color_scheme": "white"
      }
    }
  ]
}
