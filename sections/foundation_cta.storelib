<template>
<section class="fw fw-cta" data-scheme="{{ settings.color_scheme }}" data-btn="{{ theme.buttons.style }}" data-btn-shape="{{ theme.buttons.shape }}" data-btn-hover="{{ theme.buttons.hover }}" data-btn-shadow="{{ theme.buttons.shadow }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.accent }};--fw-button:{{ scheme.primary_btn_bg | default: scheme.primary_button_background }};--fw-button-text:{{ scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-border:{{ scheme.primary_btn_border | default: scheme.primary_button_border }};--fw-button-hover:{{ scheme.primary_btn_hover_bg | default: scheme.primary_button_hover_background }};--fw-button-hover-text:{{ scheme.primary_btn_hover_text | default: scheme.primary_button_hover_text | default: scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-2:{{ scheme.secondary_btn_bg | default: scheme.secondary_button_background }};--fw-button-2-text:{{ scheme.secondary_btn_text | default: scheme.secondary_button_text }};--fw-button-2-border:{{ scheme.secondary_btn_border | default: scheme.secondary_button_border }};--fw-button-2-hover:{{ scheme.secondary_btn_hover_bg | default: scheme.secondary_button_hover_background }};--fw-button-2-hover-text:{{ scheme.secondary_btn_hover_text | default: scheme.secondary_button_hover_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;"><div class="fw__inner fw-cta__inner">
 {% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw-cta__title">{{ settings.heading }}</h2><p>{{ settings.body }}</p>
 {% if settings.button_label %}<a class="fw__action" data-sl-button href="{{ settings.button_url | default: '/products' | url }}">{{ settings.button_label }} <span aria-hidden="true">↗</span></a>{% endif %}
 </div></section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
