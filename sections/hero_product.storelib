<template>
<section class="s hero3" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }} hero3__in">
    <div class="hero3__media">
      {% if settings.image %}
        <img src="{{ settings.image | asset }}" alt="{{ settings.image_alt | default: settings.heading }}" loading="eager" fetchpriority="high" decoding="async">
      {% elsif settings.button_url.image %}
        {# No picture of its own: the picture of the product the button sells. #}
        <img src="{{ settings.button_url.image | asset }}" alt="{{ settings.image_alt | default: settings.button_url.title }}" loading="eager" fetchpriority="high" decoding="async">
      {% else %}
        <div class="hero3__placeholder" aria-hidden="true"></div>
      {% endif %}
      {% if settings.badge %}<span class="hero3__badge">{{ settings.badge }}</span>{% endif %}
    </div>
    <div class="hero3__copy">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {# The product chosen fills the name and the price. A typed name overrides the name; a typed price shows only with no product chosen, because checkout charges the product's own. #}
      {% if settings.heading or settings.button_url.title %}<h1 class="s__h">{{ settings.heading | default: settings.button_url.title }}</h1>{% elsif page.in_editor %}<p class="empty">Choose the product in the sidebar</p>{% endif %}
      {% if settings.price or settings.button_url.price %}
        <p class="hero3__price">
          <span class="hero3__now">{{ settings.button_url.price | default: settings.price }}</span>
          {% if settings.button_url.title %}{% if settings.button_url.compare_price %}<s class="hero3__was">{{ settings.button_url.compare_price }}</s>{% endif %}{% elsif settings.compare_price %}<s class="hero3__was">{{ settings.compare_price }}</s>{% endif %}
        </p>
      {% endif %}
      {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      {% if settings.button_text and settings.button_url %}
        <div class="s__btns">
          <a class="s__btn s__btn--primary hero3__buy" href="{{ settings.button_url.checkout_url | default: settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>
          {% if settings.button2_text %}<a class="s__btn s__btn--secondary" href="{{ settings.button2_url | default: '#' | url }}">{{ settings.button2_text }}</a>{% endif %}
        </div>
      {% endif %}
      {% if settings.detail_1 or settings.detail_2 or settings.detail_3 %}
        <ul class="hero3__details">
          {% if settings.detail_1 %}<li>{{ settings.detail_1 }}</li>{% endif %}
          {% if settings.detail_2 %}<li>{{ settings.detail_2 }}</li>{% endif %}
          {% if settings.detail_3 %}<li>{{ settings.detail_3 }}</li>{% endif %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.hero3__in { display: grid; gap: 36px; align-items: center; grid-template-columns: 1fr; }
@container (min-width: 860px) { .hero3__in { grid-template-columns: 1.05fr 1fr; gap: 56px; } }
.hero3__media { position: relative; overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); }
.hero3__media img { display: block; width: 100%; object-fit: cover; aspect-ratio: 1 / 1; }
.hero3__placeholder { width: 100%; aspect-ratio: 1 / 1; }
.hero3__badge {
  position: absolute; top: 14px; left: 14px; padding: 5px 10px; border-radius: 999px;
  font-size: 12px; font-weight: 600; background: var(--s-btn); color: var(--s-btn-text);
}
.hero3__copy { max-width: 30rem; }
.empty { margin: 0; font-size: 14px; color: var(--s-para); opacity: 0.6; }
.hero3__price { margin: 18px 0 0; display: flex; align-items: baseline; gap: 10px; }
.hero3__now { font-size: 26px; font-weight: 700; color: var(--s-heading); }
.hero3__was { font-size: 16px; color: var(--s-para); opacity: 0.7; }
.hero3__buy { min-width: 190px; }
.hero3__details { margin: 24px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; border-top: 1px solid var(--s-border); padding-top: 18px; }
.hero3__details li { font-size: 14px; line-height: 1.5; color: var(--s-para); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "hero_product",
  "name": "Product Hero",
  "category": "hero",
  "description": "One product at the top of the page: picture, price and a way to buy it.",
  "version": "1.0.0",
  "icon": "shopping-bag",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "default": ""
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Corner label",
      "default": "",
      "placeholder": "Back in stock"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Product name",
      "info": "Leave empty to use the product's.",
      "default": ""
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "info": "Leave empty to use the product's.",
      "default": ""
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Was",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Waxed canvas, leather handles, and room for a laptop and a lunch."
    },
    {
      "type": "text",
      "id": "detail_1",
      "label": "Detail 1",
      "default": "Ships in 2 working days"
    },
    {
      "type": "text",
      "id": "detail_2",
      "label": "Detail 2",
      "default": ""
    },
    {
      "type": "text",
      "id": "detail_3",
      "label": "Detail 3",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_buttons",
      "label": "Buttons"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Buy it"
    },
    {
      "type": "product_picker",
      "id": "button_url",
      "label": "Product", "info": "The button opens this product's checkout.",
      "default": ""
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Second button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Second button link",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Product Hero"
    }
  ]
}
</schema>
