      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    }
  ],
  "presets": [
    {
      "name": "Search results",
      "settings": {
        "placeholder": "Search products",
        "button_text": "Search",
        "show_price": true,
        "max_width": "wide"
      }
