<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {# The heading, the field, then what it found. Somebody who searched and
       got the wrong thing changes one word here rather than going back to
       the header to start again. What is listed is always the shop's own
       products, the ones the words matched (app/(site)/w/[username]/search):
       a search page that showed a hand-picked list would answer every
       question with the same things. #}
    {% if settings.heading %}<h1 class="s__h">{{ settings.heading }}</h1>{% endif %}

    <form class="find" action="/search" method="get" role="search">
      <label class="find__field">
        <svg class="find__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="find__input" type="search" name="q" value="{{ page.query }}" placeholder="{{ settings.placeholder }}" aria-label="{{ settings.placeholder }}" autocomplete="off" enterkeyhint="search">
      </label>
      <button class="find__go" type="submit">{{ settings.button_text }}</button>
    </form>

    {# The count is the list's own size and the words are the visitor's, so
       neither is a setting somebody could be asked to keep in step. With no
       query this is the whole shop, and the creator's own line goes here. #}
    {% if settings.show_filters and page.filters %}
      {# Filters beside what was found, kept with the words searched for:
         lib/products/catalog-filters.ts. The bar says how many. #}
      {% if page.query %}<p class="s__sub">{{ words.results_for }} "{{ page.query }}"</p>{% elsif settings.intro %}<p class="s__sub">{{ settings.intro }}</p>{% endif %}
      <div class="cat{% if page.filters.price.show or page.filters.groups.size > 0 %}{% else %} cat--bare{% endif %}">
        <form class="cat__form" action="{{ page.filters.path | url }}" method="get" data-storelib-filters>
          {% if page.filters.q %}<input type="hidden" name="q" value="{{ page.filters.q }}">{% endif %}
          <input class="cat__toggle" type="checkbox" id="{{ section.id }}-filters" aria-hidden="true" tabindex="-1">
          <div class="cat__bar">
            <label class="cat__open" for="{{ section.id }}-filters">{{ settings.filter_label }}{% if page.filters.active_count > 0 %} ({{ page.filters.active_count }}){% endif %}</label>
            <p class="cat__count" aria-live="polite">{{ page.filters.count_label }}</p>
            <label class="cat__sort"><span class="cat__sortl">{{ settings.sort_label }}</span>
              <select name="sort">{% for o in page.filters.sort_options %}<option value="{{ o.value }}"{% if o.selected %} selected{% endif %}>{{ o.label }}</option>{% endfor %}</select>
            </label>
          </div>
          <div class="cat__panel" role="group" aria-label="{{ settings.filter_label }}">
            {% if page.filters.price.show %}
            <fieldset class="cat__group">
              <legend class="cat__legend">{{ words.price }}</legend>
              <div class="cat__range">
                <label class="cat__num"><span>$</span><input type="number" name="price_min" min="0" step="1" inputmode="numeric" placeholder="{{ page.filters.price.min }}" value="{{ page.filters.price.from }}" aria-label="{{ words.lowest_price }}"></label>
                <span class="cat__to">{{ words.price_to }}</span>
                <label class="cat__num"><span>$</span><input type="number" name="price_max" min="0" step="1" inputmode="numeric" placeholder="{{ page.filters.price.max }}" value="{{ page.filters.price.to }}" aria-label="{{ words.highest_price }}"></label>
              </div>
            </fieldset>
            {% endif %}
            {% for g in page.filters.groups %}
            <fieldset class="cat__group">
              <legend class="cat__legend">{{ g.label }}</legend>
              {% for v in g.values %}
              <label class="cat__opt{% if v.disabled %} cat__opt--off{% endif %}"><input type="checkbox" name="{{ g.param }}" value="{{ v.value }}"{% if v.checked %} checked{% endif %}{% if v.disabled %} disabled{% endif %}>{% if v.swatch %}<span class="cat__sw" style="background: {{ v.swatch }};"></span>{% endif %}<span class="cat__lab">{{ v.label }}</span><span class="cat__n">{{ v.count }}</span></label>
              {% endfor %}
            </fieldset>
            {% endfor %}
            <div class="cat__actions">
              <button type="submit" class="cat__apply">{{ settings.apply_label }}</button>
              {% if page.filters.active %}<a class="cat__clear" href="{{ page.filters.clear_url | url }}">{{ settings.clear_label }}</a>{% endif %}
            </div>
          </div>
        </form>
        <div class="cat__results">
          {% if page.filters.chips.size > 0 %}
          <div class="cat__chips">{% for c in page.filters.chips %}<a class="cat__chip" href="{{ c.url | url }}" aria-label="{{ words.remove }} {{ c.label }}">{{ c.label }}<span aria-hidden="true">×</span></a>{% endfor %}<a class="cat__chip cat__chip--clear" href="{{ page.filters.clear_url | url }}">{{ settings.clear_label }}</a></div>
          {% endif %}
          {% if products.size == 0 %}
            {% if page.filters.active %}
            <div class="none"><p class="none__h">{{ settings.no_match }}</p><a class="none__a" href="{{ page.filters.clear_url | url }}">{{ settings.clear_label }}</a></div>
            {% else %}
      <div class="none">
        <p class="none__h">{% if page.query %}{{ words.no_results_for }} "{{ page.query }}"{% else %}{{ settings.empty_text }}{% endif %}</p>
        {% if page.query %}<p class="none__p">{{ settings.empty_text }}</p><a class="none__a" href="{{ settings.all_url | default: '/products' | url }}">{{ settings.all_label }}</a>{% endif %}
      </div>
            {% endif %}
          {% else %}
      <div class="grid">
        {% for block in products %}
        <article class="card card__wrap" data-card="product" data-block-id="{{ block.id }}">
          <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
            {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% else %}<span class="card__none" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>{% endif %}
            {# Theme settings › Badges, the way the shop's grid draws them: Sale on a discounted product, then the card's own tag. #}{% if block.settings.tag or theme.badges.sale and block.settings.compare_price %}<span class="badges" data-badges>{% if theme.badges.sale and block.settings.compare_price %}<span class="tag" data-badge="sale">{{ theme.badges.sale_text }}</span>{% endif %}{% if block.settings.tag %}<span class="tag" data-badge="{% if block.settings.tag == 'Sold out' %}soldout{% else %}tag{% endif %}">{{ block.settings.tag }}</span>{% endif %}</span>{% endif %}
            {% if settings.show_wishlist %}<button type="button" class="heart" data-storelib-wishlist="{{ block.id }}" aria-pressed="false" aria-label="{{ words.save }} {{ block.settings.title }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button>{% endif %}
          </div>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          {% if settings.show_price and block.settings.price %}
            <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
          {% endif %}
          {% if block.settings.url %}<a class="card__link" href="{{ block.settings.url | url }}"><span class="sr">{{ block.settings.title }}</span></a>{% endif %}
        </article>
        {% endfor %}
      </div>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% if page.query %}
        {% if products.size > 0 %}<p class="s__sub" aria-live="polite">{{ products.size }} {% if products.size == 1 %}{{ words.result }}{% else %}{{ words.results }}{% endif %} {{ words.search_for }} "{{ page.query }}"</p>{% endif %}
      {% elsif settings.intro %}
        <p class="s__sub">{{ settings.intro }}</p>
      {% endif %}
      {% if products.size == 0 %}
      <div class="none">
        <p class="none__h">{% if page.query %}{{ words.no_results_for }} "{{ page.query }}"{% else %}{{ settings.empty_text }}{% endif %}</p>
        {% if page.query %}<p class="none__p">{{ settings.empty_text }}</p><a class="none__a" href="{{ settings.all_url | default: '/products' | url }}">{{ settings.all_label }}</a>{% endif %}
      </div>
      {% else %}
      <div class="grid">
        {% for block in products %}
        <article class="card card__wrap" data-card="product" data-block-id="{{ block.id }}">
          <div class="card__media" data-card-media style="aspect-ratio: {{ settings.shape }};">
            {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% else %}<span class="card__none" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>{% endif %}
            {# Theme settings › Badges, the way the shop's grid draws them: Sale on a discounted product, then the card's own tag. #}{% if block.settings.tag or theme.badges.sale and block.settings.compare_price %}<span class="badges" data-badges>{% if theme.badges.sale and block.settings.compare_price %}<span class="tag" data-badge="sale">{{ theme.badges.sale_text }}</span>{% endif %}{% if block.settings.tag %}<span class="tag" data-badge="{% if block.settings.tag == 'Sold out' %}soldout{% else %}tag{% endif %}">{{ block.settings.tag }}</span>{% endif %}</span>{% endif %}
            {% if settings.show_wishlist %}<button type="button" class="heart" data-storelib-wishlist="{{ block.id }}" aria-pressed="false" aria-label="{{ words.save }} {{ block.settings.title }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button>{% endif %}
          </div>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          {% if settings.show_price and block.settings.price %}
            <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
          {% endif %}
          {% if block.settings.url %}<a class="card__link" href="{{ block.settings.url | url }}"><span class="sr">{{ block.settings.title }}</span></a>{% endif %}
        </article>
        {% endfor %}
      </div>
      {% endif %}
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }

/* The field. One row on a phone as well, because a search button that wraps
   under its own input reads as two controls that are not related. */
.find { display: flex; gap: 8px; align-items: stretch; margin-top: 20px; max-width: 720px; }
.find__field {
  position: relative; flex: 1 1 auto; min-width: 0; display: flex; align-items: center;
  background: var(--s-bg); border: 1px solid var(--s-border); border-radius: var(--s-radius);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.find__field:focus-within { border-color: var(--s-heading); box-shadow: 0 0 0 3px color-mix(in srgb, var(--s-heading) 10%, transparent); }
.find__icon { position: absolute; left: 14px; width: 18px; height: 18px; fill: none; stroke: var(--s-para); stroke-width: 2; stroke-linecap: round; opacity: 0.7; pointer-events: none; }
.find__input {
  width: 100%; min-width: 0;
  padding: 13px 16px 13px 42px; font: inherit; font-size: 16px; /* 16px: iOS zooms a smaller field on focus */
  color: var(--s-heading); background: transparent; border: 0; border-radius: inherit; outline: none;
}
.find__input::placeholder { color: var(--s-para); opacity: 0.6; }
/* Safari draws its own cancel control inside a `type=search`, in its own
   colours, and it lands on the border. */
.find__input::-webkit-search-decoration,
.find__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
.find__go {
  flex: 0 0 auto;
  padding: 13px 22px; font: inherit; font-size: 15px; font-weight: 600;
  color: var(--s-btn-text); background: var(--s-btn);
  border: 1px solid var(--s-btn); border-radius: var(--s-radius);
  cursor: pointer; transition: opacity 150ms ease;
}
.find__go:hover { opacity: 0.88; }
.find__go:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }

.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 28px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 10px 0 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }

.grid { display: grid; gap: 24px 12px; margin-top: 28px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { gap: 28px 20px; grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.card { display: flex; flex-direction: column; min-width: 0; }
.card__wrap { position: relative; }
.card__media { position: relative; overflow: hidden; border-radius: var(--s-radius); background: color-mix(in srgb, var(--s-border) 55%, var(--s-bg)); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__media img { transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1); }
@media (prefers-reduced-motion: reduce) { .card__media img { transition: none; } }
@media (hover: hover) { .card__wrap:hover .card__media img { transform: scale(1.03); } }
.card__none { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.card__none svg { width: 28px; height: 28px; fill: none; stroke: var(--s-para); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; opacity: 0.45; }
.card__title {
  margin: 12px 0 0; font-size: 15px; line-height: 1.35; font-weight: 600; color: var(--s-heading);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.card__price { margin: 6px 0 0; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 500; color: var(--s-heading); font-variant-numeric: tabular-nums; }
.card__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.7; }
.card__link { position: absolute; inset: 0; border-radius: var(--s-radius); }
.card__link:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; }
.badges { position: absolute; top: 10px; left: 10px; display: flex; flex-wrap: wrap; gap: 6px; max-width: calc(100% - 64px); }
.tag { padding: 4px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; line-height: 1.3; background: var(--s-btn); color: var(--s-btn-text); }
.tag[data-badge="soldout"] { background: var(--s-bg); color: var(--s-heading); box-shadow: inset 0 0 0 1px var(--s-border); }
/* Nothing found: said once, with the words asked, and a way back to everything. */
.none { margin: 40px auto 8px; max-width: 420px; text-align: center; }
.none__h { margin: 0; font-size: 17px; font-weight: 600; color: var(--s-heading); }
.none__p { margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: var(--s-para); }
.none__a { display: inline-block; margin-top: 16px; font-size: 14px; font-weight: 600; color: var(--s-heading); text-underline-offset: 3px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
/* The heart: over the card's link and above it, so pressing it saves the
   product rather than opening it. Filled once it is saved. */
.heart {
  position: absolute; top: 10px; right: 10px; z-index: 2;
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; padding: 0;
  color: var(--s-heading); background: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: 999px;
  cursor: pointer; -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease;
}
.heart svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; transition: fill 150ms ease; }
.heart[aria-pressed="true"] svg { fill: currentColor; }
.heart:active { transform: scale(0.92); }
.heart:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { .heart, .heart svg { transition: none; } }

/* ── Filters: a sidebar beside the grid on a computer, a panel that opens
   under the bar on a phone. A plain GET form: the address is the state, so
   a filtered list can be linked and reloaded, and it works before any
   script. The page submits it as soon as a box is ticked. ── */
.cat { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "bar" "side" "main"; column-gap: 40px; margin-top: 8px; }
.cat__form { display: contents; }
.cat__toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.cat__bar { grid-area: bar; display: flex; align-items: center; gap: 12px; padding: 0 0 16px; border-bottom: 1px solid var(--s-border); }
.cat__open {
  display: inline-flex; flex: 0 0 auto; align-items: center; height: 40px; padding: 0 16px; font-size: 14px; font-weight: 600; white-space: nowrap; cursor: pointer;
  color: var(--s-heading); border: 1px solid var(--s-border); border-radius: var(--s-radius); -webkit-tap-highlight-color: transparent;
}
.cat__toggle:checked ~ .cat__bar .cat__open { border-color: var(--s-heading); }
.cat__toggle:focus-visible ~ .cat__bar .cat__open { outline: 2px solid var(--s-heading); outline-offset: 2px; }
.cat__count { margin: 0; min-width: 0; font-size: 14px; color: var(--s-para); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cat__sort { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--s-para); }
.cat__sortl { display: none; }
.cat__sort select {
  height: 40px; max-width: 44vw; padding: 0 30px 0 12px; font: inherit; font-size: 14px; color: var(--s-heading); background-color: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: var(--s-radius); -webkit-appearance: none; appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
  background-position: calc(100% - 15px) 18px, calc(100% - 10px) 18px; background-size: 5px 5px; background-repeat: no-repeat;
}
.cat__panel { grid-area: side; display: none; padding: 8px 0 16px; border-bottom: 1px solid var(--s-border); }
.cat__toggle:checked ~ .cat__panel { display: block; }
.cat__group { margin: 0; padding: 14px 0; border: 0; border-top: 1px solid var(--s-border); min-width: 0; }
.cat__group:first-child { border-top: 0; }
/* Floated, so the fieldset's rule runs above it rather than through it. */
.cat__legend { float: left; width: 100%; padding: 0; margin: 0 0 8px; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.cat__legend + * { clear: both; }
.cat__opt { display: flex; align-items: center; gap: 10px; min-height: 36px; font-size: 14px; color: var(--s-text); cursor: pointer; }
.cat__opt input { width: 18px; height: 18px; margin: 0; accent-color: var(--s-heading); flex: 0 0 auto; }
.cat__opt--off { opacity: 0.45; cursor: default; }
.cat__sw { width: 18px; height: 18px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12); flex: 0 0 auto; }
.cat__lab { flex: 1 1 auto; min-width: 0; }
.cat__n { font-size: 13px; color: var(--s-para); opacity: 0.75; font-variant-numeric: tabular-nums; }
.cat__range { display: flex; align-items: center; gap: 8px; }
.cat__num { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 4px; height: 40px; padding: 0 10px; border: 1px solid var(--s-border); border-radius: var(--s-radius); color: var(--s-para); }
.cat__num input { width: 100%; min-width: 0; border: 0; outline: none; background: transparent; font: inherit; font-size: 16px; color: var(--s-heading); -moz-appearance: textfield; }
.cat__num input::-webkit-outer-spin-button, .cat__num input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.cat__to { font-size: 13px; color: var(--s-para); }
.cat__actions { display: flex; align-items: center; gap: 16px; padding-top: 14px; }
.cat__apply { height: 40px; padding: 0 20px; font: inherit; font-size: 14px; font-weight: 600; color: var(--s-btn-text); background: var(--s-btn); border: 1px solid var(--s-btn); border-radius: var(--s-radius); cursor: pointer; }
.cat__clear { font-size: 14px; color: var(--s-heading); text-underline-offset: 3px; }
.cat__results { grid-area: main; min-width: 0; container-type: inline-size; padding-top: 20px; }
.cat__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
.cat__chip { display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px; font-size: 13px; color: var(--s-heading); text-decoration: none; border: 1px solid var(--s-border); border-radius: 999px; }
.cat__chip--clear { border-color: transparent; text-decoration: underline; text-underline-offset: 3px; }
.cat .grid { margin-top: 0; }
.cat .none { margin-top: 24px; }
@container (min-width: 900px) {
  .cat { grid-template-columns: 240px minmax(0, 1fr); grid-template-areas: "side bar" "side main"; }
  .cat__open { display: none; }
  .cat__sortl { display: inline; }
  .cat__panel { display: block; align-self: start; padding: 0; border-bottom: 0; }
  .cat__group:first-child { padding-top: 4px; }
}

/* Nothing to filter by (one product, no options): no Filter button and no
   empty column holding a lone Apply; the bar keeps the count and the sort. */
.cat--bare .cat__open, .cat--bare .cat__panel { display: none !important; }
@container (min-width: 900px) { .cat.cat--bare { grid-template-columns: minmax(0, 1fr); grid-template-areas: "bar" "main"; } }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "search",
  "name": "Search results",
  "category": "products",
  "description": "The search field and what it found in your shop. Shows every product until somebody searches.",
  "version": "1.0.0",
  "icon": "search",
  "settings": [
    {
      "type": "header",
      "id": "hdr_field",
      "label": "The field"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Search products"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Search"
    },
    {
      "type": "header",
      "id": "hdr_results",
      "label": "Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Before anybody has searched",
      "default": "Everything in the shop.",
      "info": "Replaced by the number of results once somebody does."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "When nothing matches",
      "default": "Check the spelling, or try a shorter word.",
      "info": "Shown under \"No results for\" and the words that were searched."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Link back to everything",
      "default": "See all products"
    },
    {
      "type": "url",
      "id": "all_url",
      "label": "Goes to",
      "default": "/products"
    },
    {
      "type": "toggle",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_wishlist",
      "label": "Show a heart to save",
      "default": true,
      "info": "On your shop's products. Saved ones are listed on the Wishlist page."
    },
    {
      "type": "header",
      "id": "hdr_filters",
      "label": "Filters"
    },
    {
      "type": "toggle",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter button",
      "default": "Filter",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort by",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply button",
      "default": "Apply",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear link",
      "default": "Clear all",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "text",
      "id": "no_match",
      "label": "When nothing matches the filters",
      "default": "No products match these filters.",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 4,
        "tablet": 3,
        "mobile": 2
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Image shape",
      "default": "1 / 1",
      "options": [
        {
          "label": "Square",
          "value": "1 / 1"
        },
        {
          "label": "Portrait",
          "value": "3 / 4"
        },
        {
