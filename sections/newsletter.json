{
  "type": "newsletter",
  "name": "Newsletter signup",
  "description": "Grow your email list with an inline or split signup section.",
  "supports_typography_overrides": false,
  "icon": "mail",
  "category": "marketing",
  "fields": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Stay in the loop",
      "placeholder": "Section heading"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "textarea",
      "default": "Get the latest updates, tips, and exclusive offers delivered straight to your inbox.",
      "placeholder": "Supporting text"
    },
    {
      "id": "incentive_text",
      "label": "Incentive / offer text",
      "type": "text",
      "default": "Get 10% off your first order when you subscribe.",
      "placeholder": "e.g. Get 10% off…"
    },
    {
      "id": "placeholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "Enter your email address",
      "placeholder": "Input placeholder text"
    },
    {
      "id": "show_name_field",
      "label": "Show first name field",
      "type": "toggle",
      "default": false
    },
    {
      "id": "button_text",
      "label": "Button text",
      "type": "text",
      "default": "Subscribe",
      "placeholder": "CTA button label"
    },
    {
      "id": "disclaimer",
      "label": "Disclaimer text",
      "type": "textarea",
      "default": "We respect your privacy. Unsubscribe at any time.",
      "placeholder": "Privacy / GDPR note"
    },
    {
      "id": "success_message",
      "label": "Success message",
      "type": "text",
      "default": "Thanks, you're on the list.",
      "placeholder": "Shown after successful signup"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "centered",
      "options": [
        {
          "label": "Centered",
          "value": "centered"
        },
        {
          "label": "Split (image + form)",
          "value": "split"
        }
      ]
    },
    {
      "id": "bg_image",
      "label": "Background / split image",
      "type": "image",
      "default": ""
    },
    {
      "id": "bg_overlay_opacity",
      "label": "Overlay opacity",
      "type": "range",
      "default": 40,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "color_scheme",
      "label": "Color scheme",
      "type": "select",
      "default": "white",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Soft",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Brand",
          "value": "black"
        },
        {
          "label": "Accent",
          "value": "highlight"
        }
      ]
    },
    {
      "id": "bg_color",
      "label": "Background color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "text_color",
      "label": "Text color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the section's color scheme."
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Centered newsletter with incentive",
      "settings": {
        "heading": "Stay in the loop",
        "subheading": "Get the latest updates and exclusive offers delivered to your inbox.",
        "incentive_text": "Get 10% off your first order when you subscribe.",
        "placeholder": "Enter your email address",
        "show_name_field": false,
        "button_text": "Subscribe",
        "disclaimer": "We respect your privacy. Unsubscribe at any time.",
        "success_message": "Thanks, you're on the list.",
        "layout": "centered",
        "bg_overlay_opacity": 40,
        "padding_top": 60,
        "padding_bottom": 60,
        "color_scheme": "dark"
      }
    }
  ]
}
