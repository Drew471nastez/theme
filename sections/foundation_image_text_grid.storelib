<template>
<section class="fw fw-itg" data-scheme="{{ settings.color_scheme }}" data-btn="{{ theme.buttons.style }}" data-btn-shape="{{ theme.buttons.shape }}" data-btn-hover="{{ theme.buttons.hover }}" data-btn-shadow="{{ theme.buttons.shadow }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.accent }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;"><div class="fw__inner fw-itg__layout">
 <div class="fw-itg__image">{% if settings.image %}<img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="lazy" decoding="async">{% else %}<div class="fw-itg__empty" aria-hidden="true"><span></span></div>{% endif %}</div>
 <div class="fw-itg__copy">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% if settings.intro %}<p class="fw__lede">{{ settings.intro }}</p>{% endif %}
 <div class="fw-itg__list">{% for block in blocks %}<div class="fw-itg__item" data-block-id="{{ block.id }}"><span>✳</span><div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div></div>{% endfor %}</div>
 {% if settings.button_label %}<a class="fw__action" data-sl-button href="{{ settings.button_url | default: '/products' | url }}">{{ settings.button_label }} ↗</a>{% endif %}</div>
 </div></section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:calc(var(--fw-top) * var(--theme-spacing-scale,1)) var(--theme-padding-x, 24px) calc(var(--fw-bottom) * var(--theme-spacing-scale,1));margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-family:var(--sl-caption-font, var(--theme-font-accent, var(--theme-font-body))),sans-serif;font-size:var(--sl-caption-size, var(--type-caption-size, 11px));font-weight:var(--sl-caption-weight, var(--type-caption-weight, 700));letter-spacing:var(--sl-caption-tracking, var(--type-caption-tracking, .14em));text-transform:var(--sl-caption-transform, var(--type-caption-transform, uppercase));line-height:var(--type-caption-line-height, 1.4);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font, var(--type-h2-font, var(--theme-font-heading))),sans-serif;font-size:var(--section-heading-size, var(--type-h2-size, clamp(30px, 4.2cqi, 56px)));font-weight:var(--section-heading-weight, var(--type-h2-weight, 650));line-height:var(--section-heading-line-height, var(--type-h2-line-height, 1.12));letter-spacing:var(--section-heading-tracking, var(--type-h2-tracking, -.04em));text-transform:var(--section-heading-transform, var(--type-h2-transform, none));overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--section-body-font, var(--type-body-font, var(--theme-font-body))),sans-serif;font-size:var(--section-text-size, var(--type-body-size, 16px));line-height:var(--section-text-line-height, var(--type-body-line-height, 1.7));font-weight:var(--type-body-weight, 400);letter-spacing:var(--type-body-tracking, 0);color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding, 12px 22px);text-decoration:none;border-radius:var(--theme-button-radius, var(--fw-radius));font-family:var(--type-button-font, var(--theme-font-body)),sans-serif;font-weight:var(--theme-button-weight, var(--type-button-weight, 600));font-size:var(--sl-button-size, var(--type-button-size, 15px));line-height:var(--sl-button-line-height, var(--type-button-line-height, 1.2));letter-spacing:var(--type-button-tracking, 0);text-transform:var(--type-button-transform, none);background:var(--scheme-button-primary, var(--fw-button));color:var(--scheme-button-primary-text, var(--fw-button-text));border:1px solid var(--scheme-button-primary-border, var(--fw-button));box-shadow:var(--sl-btn-shadow, none);transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,box-shadow 180ms ease,transform 220ms cubic-bezier(.22,1,.36,1);}
.fw[data-btn="outline"] .fw__action:not(.fw__action--secondary){background:transparent;color:var(--scheme-button-primary, var(--fw-button));border-color:var(--scheme-button-primary, var(--fw-button));}
.fw[data-btn="ghost"] .fw__action:not(.fw__action--secondary){background:transparent;color:var(--scheme-button-primary, var(--fw-button));border-color:transparent;box-shadow:none;}
.fw__action:hover{background:var(--scheme-button-primary-hover, var(--fw-button));color:var(--scheme-button-primary-hover-text, var(--fw-button-text));border-color:var(--scheme-button-primary-hover, var(--fw-button));}
.fw[data-btn="outline"] .fw__action:not(.fw__action--secondary):hover{background:var(--scheme-button-primary, var(--fw-button));color:var(--scheme-button-primary-text, var(--fw-button-text));}
.fw[data-btn="ghost"] .fw__action:not(.fw__action--secondary):hover{background:color-mix(in srgb, var(--scheme-button-primary, var(--fw-button)) 12%, transparent);color:var(--scheme-button-primary, var(--fw-button));}
.fw__action--secondary{background:var(--scheme-button-secondary, transparent);color:var(--scheme-button-secondary-text, var(--fw-title));border-color:var(--scheme-button-secondary-border, var(--fw-line));}
.fw__action--secondary:hover{background:var(--scheme-button-secondary-hover, transparent);color:var(--scheme-button-secondary-hover-text, var(--fw-title));}
.fw[data-btn-shape="square"] .fw__action{border-radius:0;}
.fw[data-btn-shape="pill"] .fw__action{border-radius:999px;}
.fw[data-btn-shadow="true"][data-btn="filled"] .fw__action:not(.fw__action--secondary){box-shadow:0 8px 22px color-mix(in srgb, var(--scheme-button-primary, var(--fw-button)) 24%, transparent);}
.fw[data-btn-hover="lift"] .fw__action:hover{transform:translateY(-2px);}
.fw[data-btn-hover="scale"] .fw__action:hover{transform:scale(1.03);}
.fw[data-btn-hover="none"] .fw__action,.fw[data-btn-hover="none"] .fw__action:hover{transition:none;transform:none;}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-itg__layout{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,90px);align-items:center}.fw-itg__image{width:100%;aspect-ratio:.92;overflow:hidden;background:var(--scheme-background-secondary, var(--fw-line));border-radius:var(--sl-image-radius, var(--fw-radius))}.fw-itg__image img{height:100%;width:100%;object-fit:cover}.fw-itg__empty{position:relative;height:100%;background:linear-gradient(145deg, var(--fw-bg), var(--fw-line))}.fw-itg__empty>span{position:absolute;width:55%;height:74%;background:linear-gradient(130deg, var(--fw-accent), var(--fw-bg));border-radius:43% 43% 10% 10%;transform:rotate(-18deg);top:14%;left:22%}.fw-itg__list{margin:28px 0}.fw-itg__item{display:flex;gap:18px;border-top:1px solid var(--fw-line);padding:21px 0}.fw-itg__item>span{font-size:var(--type-body-size, 16px);color:var(--fw-accent);flex:none}.fw-itg__item strong{display:block;font-family:var(--type-h4-font, var(--theme-font-heading)),sans-serif;font-size:var(--type-h4-size, 16px);font-weight:var(--type-h4-weight, 650);color:var(--fw-title)}.fw-itg__item p{margin:6px 0 0;color:var(--fw-muted);font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;font-size:var(--type-body-small-size, 14px);line-height:var(--type-body-line-height, 1.65)}
@container(max-width:750px){.fw-itg__layout{grid-template-columns:1fr}.fw-itg__image{aspect-ratio:1.35}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_image_text_grid",
  "name": "Foundation / Image and benefits",
  "category": "images",
  "description": "Large editorial image paired with an ordered list of useful features.",
  "version": "1.0.0",
  "icon": "image",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "WHY IT MATTERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for the everyday."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Simple choices, considered from the start."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "A close-up of the collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the range"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/products"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "theme",
      "options": [
        {"value": "theme", "label": "Theme setting"},
        {"value": "none", "label": "None"},
        {"value": "fade", "label": "Fade"},
        {"value": "fade_up", "label": "Fade up"},
        {"value": "rise", "label": "Rise"},
        {"value": "zoom", "label": "Zoom"},
        {"value": "blur", "label": "Blur"},
        {"value": "slide_left", "label": "From the right"},
        {"value": "slide_right", "label": "From the left"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Image and benefits",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "title": "Good from the start",
            "text": "A considered approach to everything we make."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Built around you",
            "text": "Straightforward details and a better everyday experience."
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Nothing unnecessary",
            "text": "Just the essentials, done well."
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtful by design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A simple explanation of this benefit."
        }
      ]
    }
  ]
}
</schema>
