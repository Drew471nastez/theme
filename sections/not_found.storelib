{# ===========================================================================
   The 404 page: an address this site does not have

   Somebody followed an old link or mistyped one. The page says so in one
   line, offers the way home, a search box, and a few things from the shop,
   all inside the site's own header and footer, so the visitor is still on
   the creator's site rather than looking at an error.

   This section is the 404 page's own, the way `search` is the search page's:
   it is not in the Add Section list, and the page it sits on is opened from
   the page switcher like the shop.
   =========================================================================== #}
<template>
<section class="s nf" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--wide">
    <div class="nf__head">
      {% if settings.heading %}<h1 class="s__h">{{ settings.heading }}</h1>{% endif %}
      {% if settings.text %}<p class="s__sub">{{ settings.text }}</p>{% endif %}

      {% if settings.show_search %}
        <form class="nf__find" action="/search" method="get" role="search">
          <input class="nf__input" type="search" name="q" placeholder="{{ settings.search_placeholder }}" aria-label="{{ settings.search_placeholder | default: 'Search' }}" autocomplete="off">
          <button class="s__btn s__btn--secondary nf__go" type="submit">{{ settings.search_button | default: 'Search' }}</button>
        </form>
      {% endif %}

      {% if settings.button_text %}
        <p class="nf__home"><a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '/' | url }}">{{ settings.button_text }}</a></p>
      {% endif %}
    </div>

    {% if settings.show_products %}
      {% if products.size > 0 %}
        {% if settings.products_heading %}<h2 class="nf__subhead">{{ settings.products_heading }}</h2>{% endif %}
        <div class="nf__grid">
          {% for block in products %}
            {% if forloop.index <= settings.product_count %}
            <article class="card" data-card="product" data-block-id="{{ block.id }}">
              <div class="card__media" data-card-media>
                {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
              </div>
              <h3 class="card__title">{{ block.settings.title }}</h3>
              {% if block.settings.price %}<p class="card__price">{{ block.settings.price }}</p>{% endif %}
              {% if block.settings.url %}<a class="card__link" href="{{ block.settings.url | url }}"><span class="sr">{{ block.settings.title }}</span></a>{% endif %}
            </article>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        {% if page.in_editor %}<p class="empty">A few of your published products appear here</p>{% endif %}
      {% endif %}
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.empty { margin: 40px 0 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.7; }

.nf__head { max-width: 36rem; margin-inline: auto; text-align: center; }
/* The field and its button share a line; 16px text so a phone does not zoom
   into the page when the field is tapped. */
.nf__find { display: flex; gap: 8px; margin: 28px auto 0; max-width: 28rem; }
.nf__input {
  flex: 1 1 auto; min-width: 0; height: 48px; padding: 0 16px;
  font: inherit; font-size: 16px; color: var(--s-text); background: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: var(--s-radius);
}
.nf__input:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 1px; }
.nf__go { flex: none; height: 48px; padding-block: 0; }
.nf__home { margin: 20px 0 0; }

.nf__subhead { margin: 72px 0 24px; font-size: 20px; font-weight: 600; color: var(--s-heading); text-align: center; }
.nf__grid { display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
@container (min-width: 820px) { .nf__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.card { position: relative; display: flex; flex-direction: column; }
.card__media { overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); aspect-ratio: 1 / 1; }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 12px 0 0; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__price { margin: 6px 0 0; font-size: 14px; color: var(--s-para); }
.card__link { position: absolute; inset: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "not_found",
  "name": "Page not found",
  "category": "content",
  "description": "What a visitor sees at an address the site does not have.",
  "version": "1.0.0",
  "icon": "search",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page is not here" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The link may be old, or the page may have moved." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Back to the home page" },
    { "type": "url", "id": "button_url", "label": "Button link", "default": "/" },
    { "type": "header", "id": "hdr_search", "label": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show a search box", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder", "default": "Search the shop" },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "header", "id": "hdr_products", "label": "Products" },
    { "type": "checkbox", "id": "show_products", "label": "Show some products", "default": true },
    { "type": "text", "id": "products_heading", "label": "Heading above them", "default": "From the shop" },
    { "type": "range", "id": "product_count", "label": "How many", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Page not found" }
  ]
}
</schema>
