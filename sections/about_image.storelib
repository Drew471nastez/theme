<template>
<section class="s ab ab--{{ settings.image_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }} ab__in">
    <div class="ab__media" data-media>
      {% if settings.image %}<img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="lazy" decoding="async">{% else %}<div class="ab__placeholder" aria-hidden="true"></div>{% endif %}
    </div>
    <div class="ab__copy">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {% if settings.heading %}<h2 class="s__h ab__h">{{ settings.heading }}</h2>{% endif %}
      {% if settings.body %}<div class="rt">{{ settings.body | raw }}</div>{% endif %}
      {% if blocks.size > 0 %}
        <dl class="ab__facts">
          {% for block in blocks %}
            <div data-block-id="{{ block.id }}"><dt>{{ block.settings.value }}</dt><dd>{{ block.settings.label }}</dd></div>
          {% endfor %}
        </dl>
      {% endif %}
      {% if settings.button_text %}
        <div class="s__btns"><a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a></div>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  /* The section's heading style: Heading 2 unless the section picked
     another, set by the theme stylesheet on the section root. */
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 14px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
/* Each button's hover colours come from the scheme, after the section's own
   Advanced colors: automatic until somebody chooses them. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
/* The scheme's OWN secondary-button colours, not a stand-in for them.
   This said `transparent / var(--s-heading) / var(--s-border)`, so the
   two Secondary button controls in the section panel changed nothing at
   all, and on a light scheme the outline was drawn in the faint divider
   colour instead of the dark one the scheme asks for. */
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.rt { font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.7); color: var(--s-para); }
.rt > :first-child { margin-top: 0; } .rt > :last-child { margin-bottom: 0; }
.rt p { margin: 0 0 1em; }
.rt a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }
.rt ul { margin: 0 0 1em; padding-left: 1.35em; }

.ab__h { margin-bottom: 16px; }
.ab__in { display: grid; gap: 36px; align-items: center; grid-template-columns: 1fr; }
@container (min-width: 860px) { .ab__in { grid-template-columns: 0.9fr 1.1fr; gap: 56px; } .ab--right .ab__media { order: 2; } }
.ab__media { overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); }
.ab__media img { display: block; width: 100%; object-fit: cover; aspect-ratio: 4 / 5; }
.ab__placeholder { width: 100%; aspect-ratio: 4 / 5; }
.ab__copy { max-width: 34rem; }
.ab__facts { margin: 26px 0 0; padding: 18px 0 0; border-top: 1px solid var(--s-border); display: flex; flex-wrap: wrap; gap: 28px; }
.ab__facts dt { margin: 0; font-size: 20px; font-weight: 700; color: var(--s-heading); }
.ab__facts dd { margin: 2px 0 0; font-size: 13px; color: var(--s-para); }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "about_image",
  "name": "About + Image",
  "category": "about",
  "description": "Who you are, next to a picture of it.",
  "version": "1.0.0",
  "icon": "user",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>We started in a kitchen in 2019 with one sewing machine and a market stall. The stall is gone, the machine is still here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": ""
    },
    {
      "type": "radio",
      "id": "image_side",
      "label": "Image on",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Number",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "2019"
        },
        {
          "type": "text",
          "id": "label",
          "label": "What it is",
          "default": "Started"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "About + Image"
    },
    {
      "name": "About + Image with numbers",
      "settings": {},
      "blocks": [
        {
          "id": "b1",
          "type": "fact",
          "settings": {
            "value": "2019",
            "label": "Started"
          }
        },
        {
          "id": "b2",
          "type": "fact",
          "settings": {
            "value": "4",
            "label": "People"
          }
        },
        {
          "id": "b3",
          "type": "fact",
          "settings": {
            "value": "11k",
            "label": "Parcels sent"
          }
        }
      ]
    }
  ]
}
</schema>
