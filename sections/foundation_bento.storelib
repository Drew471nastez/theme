<template>
<section class="fw fw-bento" data-scheme="{{ settings.color_scheme }}" data-btn="{{ theme.buttons.style }}" data-btn-shape="{{ theme.buttons.shape }}" data-btn-hover="{{ theme.buttons.hover }}" data-btn-shadow="{{ theme.buttons.shadow }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.accent }};--fw-button:{{ scheme.primary_btn_bg | default: scheme.primary_button_background }};--fw-button-text:{{ scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-border:{{ scheme.primary_btn_border | default: scheme.primary_button_border }};--fw-button-hover:{{ scheme.primary_btn_hover_bg | default: scheme.primary_button_hover_background }};--fw-button-hover-text:{{ scheme.primary_btn_hover_text | default: scheme.primary_button_hover_text | default: scheme.primary_btn_text | default: scheme.primary_button_text }};--fw-button-2:{{ scheme.secondary_btn_bg | default: scheme.secondary_button_background }};--fw-button-2-text:{{ scheme.secondary_btn_text | default: scheme.secondary_button_text }};--fw-button-2-border:{{ scheme.secondary_btn_border | default: scheme.secondary_button_border }};--fw-button-2-hover:{{ scheme.secondary_btn_hover_bg | default: scheme.secondary_button_hover_background }};--fw-button-2-hover-text:{{ scheme.secondary_btn_hover_text | default: scheme.secondary_button_hover_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner">
  <div class="fw-bento__intro"><div>{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2></div>{% if settings.intro %}<p>{{ settings.intro }}</p>{% endif %}</div>
  <div class="fw-bento__grid">
   {% for block in blocks %}<a class="fw-bento__card" href="{{ block.settings.url | default: '/products' | url }}" data-block-id="{{ block.id }}">
    {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" loading="lazy" decoding="async" alt="{{ block.settings.image_alt }}">{% else %}<span class="fw-bento__figure" aria-hidden="true"><span></span></span>{% endif %}
    <span class="fw-bento__veil"></span><span class="fw-bento__content"><small>{{ block.settings.kicker }}</small><strong>{{ block.settings.title }}</strong><span aria-hidden="true">↗</span></span>
   </a>{% endfor %}
  </div>
  {% if blocks.size == 0 and page.in_editor %}<p>Add cards in the sidebar.</p>{% endif %}
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a:not(.fw__action){color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:calc(var(--fw-top) * var(--theme-spacing-scale,1)) var(--theme-padding-x, 24px) calc(var(--fw-bottom) * var(--theme-spacing-scale,1));margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-family:var(--sl-caption-font, var(--theme-font-accent, var(--theme-font-body))),sans-serif;font-size:var(--sl-caption-size, var(--type-caption-size, 11px));font-weight:var(--sl-caption-weight, var(--type-caption-weight, 700));letter-spacing:var(--sl-caption-tracking, var(--type-caption-tracking, .14em));text-transform:var(--sl-caption-transform, var(--type-caption-transform, uppercase));line-height:var(--type-caption-line-height, 1.4);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font, var(--type-h2-font, var(--theme-font-heading))),sans-serif;font-size:var(--section-heading-size, var(--type-h2-size, clamp(30px, 4.2cqi, 56px)));font-weight:var(--section-heading-weight, var(--type-h2-weight, 650));line-height:var(--section-heading-line-height, var(--type-h2-line-height, 1.12));letter-spacing:var(--section-heading-tracking, var(--type-h2-tracking, -.04em));text-transform:var(--section-heading-transform, var(--type-h2-transform, none));overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--section-body-font, var(--type-body-font, var(--theme-font-body))),sans-serif;font-size:var(--section-text-size, var(--type-body-size, 16px));line-height:var(--section-text-line-height, var(--type-body-line-height, 1.7));font-weight:var(--type-body-weight, 400);letter-spacing:var(--type-body-tracking, 0);color:var(--fw-muted);}
.fw a.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding, 12px 22px);text-decoration:none;border-radius:var(--theme-button-radius, var(--fw-radius));font-family:var(--type-button-font, var(--theme-font-body)),sans-serif;font-weight:var(--theme-button-weight, var(--type-button-weight, 600));font-size:var(--sl-button-size, var(--type-button-size, 15px));line-height:var(--sl-button-line-height, var(--type-button-line-height, 1.2));letter-spacing:var(--type-button-tracking, 0);text-transform:var(--type-button-transform, none);background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));border:1px solid var(--fw-button-border, var(--fw-button, var(--scheme-button-primary-border)));box-shadow:var(--sl-btn-shadow, none);transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,box-shadow 180ms ease,transform 220ms cubic-bezier(.22,1,.36,1);}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:var(--fw-button, var(--scheme-button-primary));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary){background:transparent;color:var(--fw-button, var(--scheme-button-primary));border-color:transparent;box-shadow:none;}
.fw a.fw__action:hover{background:var(--fw-button-hover, var(--fw-button, var(--scheme-button-primary-hover)));color:var(--fw-button-hover-text, var(--fw-button-text, var(--scheme-button-primary-hover-text)));border-color:var(--fw-button-hover, var(--fw-button));}
.fw[data-btn="outline"] a.fw__action:not(.fw__action--secondary):hover{background:var(--fw-button, var(--scheme-button-primary));color:var(--fw-button-text, var(--scheme-button-primary-text));}
.fw[data-btn="ghost"] a.fw__action:not(.fw__action--secondary):hover{background:color-mix(in srgb, var(--fw-button, var(--scheme-button-primary)) 12%, transparent);color:var(--fw-button, var(--scheme-button-primary));}
.fw a.fw__action.fw__action--secondary{background:var(--fw-button-2, var(--scheme-button-secondary, transparent));color:var(--fw-button-2-text, var(--scheme-button-secondary-text, var(--fw-title)));border-color:var(--fw-button-2-border, var(--scheme-button-secondary-border, var(--fw-line)));}
.fw a.fw__action.fw__action--secondary:hover{background:var(--fw-button-2-hover, var(--fw-button-2, var(--scheme-button-secondary-hover, transparent)));color:var(--fw-button-2-hover-text, var(--fw-button-2-text, var(--scheme-button-secondary-hover-text, var(--fw-title))));}
.fw[data-btn-shape="square"] .fw__action{border-radius:0;}
.fw[data-btn-shape="pill"] .fw__action{border-radius:999px;}
.fw[data-btn-shadow="true"][data-btn="filled"] .fw__action:not(.fw__action--secondary){box-shadow:0 8px 22px color-mix(in srgb, var(--scheme-button-primary, var(--fw-button)) 24%, transparent);}
.fw[data-btn-hover="lift"] .fw__action:hover{transform:translateY(-2px);}
.fw[data-btn-hover="scale"] .fw__action:hover{transform:scale(1.03);}
.fw[data-btn-hover="none"] .fw__action,.fw[data-btn-hover="none"] .fw__action:hover{transition:none;transform:none;}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-bento__intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.fw-bento__intro>p{max-width:37ch;font-family:var(--type-body-font, var(--theme-font-body)),sans-serif;font-size:var(--type-body-small-size, 14px);line-height:var(--type-body-line-height, 1.7);color:var(--fw-muted);margin:0}.fw-bento__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.fw-bento__card{position:relative;display:block;min-height:300px;overflow:hidden;border-radius:var(--sl-image-radius, var(--fw-radius));text-decoration:none;isolation:isolate;background:var(--scheme-background-secondary, var(--fw-line))}.fw-bento__card:first-child{grid-row:span 2;min-height:615px}.fw-bento__card img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;transition:transform .55s cubic-bezier(.2,.8,.2,1)}.fw-bento__card:hover img{transform:scale(1.045)}.fw-bento__figure{position:absolute;inset:0;background:linear-gradient(120deg, color-mix(in srgb, var(--fw-accent) 28%, var(--fw-bg)), var(--fw-accent))}.fw-bento__figure>span{position:absolute;inset:16% 25% 13%;border-radius:50% 50% 12% 12%;transform:rotate(-19deg);background:linear-gradient(120deg, var(--fw-accent), var(--fw-bg))}.fw-bento__veil{position:absolute;inset:0;background:linear-gradient(transparent 48%, #162019cc)}.fw-bento__content{position:absolute;bottom:26px;left:30px;right:24px;color:#fff;display:grid;grid-template-columns:1fr auto;gap:6px;align-items:end}.fw-bento__content small{grid-column:1/-1;font-family:var(--sl-caption-font, var(--theme-font-accent)),sans-serif;font-size:var(--sl-caption-size, 11px);letter-spacing:var(--sl-caption-tracking, .12em);text-transform:var(--sl-caption-transform, uppercase);opacity:.85}.fw-bento__content strong{font-family:var(--type-h3-font, var(--theme-font-heading)),sans-serif;font-size:var(--type-h3-size, clamp(23px, 2.7cqi, 38px));line-height:var(--type-h3-line-height, 1.12);letter-spacing:var(--type-h3-tracking, -.03em);font-weight:var(--type-h3-weight, 650)}.fw-bento__content>span{font-size:25px}.fw-bento__card:nth-child(4){grid-column:span 2;min-height:330px}
@container(max-width:650px){.fw-bento__intro{display:block}.fw-bento__intro>p{margin-top:12px}.fw-bento__grid{grid-template-columns:1fr}.fw-bento__card,.fw-bento__card:first-child,.fw-bento__card:nth-child(4){min-height:310px;grid-column:auto;grid-row:auto}.fw-bento__content{bottom:23px;left:23px}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_bento",
  "name": "Foundation / Editorial bento",
  "category": "images",
  "description": "Materia-inspired asymmetrical bento cards with image placeholders and editable links.",
  "version": "1.0.0",
  "icon": "grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "BROWSE BY INTEREST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next favourite."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Supporting text",
      "default": "A little something for every mood and moment."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "theme",
      "options": [
        {"value": "theme", "label": "Theme setting"},
        {"value": "none", "label": "None"},
        {"value": "fade", "label": "Fade"},
        {"value": "fade_up", "label": "Fade up"},
        {"value": "rise", "label": "Rise"},
        {"value": "zoom", "label": "Zoom"},
        {"value": "blur", "label": "Blur"},
        {"value": "slide_left", "label": "From the right"},
        {"value": "slide_right", "label": "From the left"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial bento",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "kicker": "COLLECTION 01",
            "title": "The essentials",
            "url": "/products"
          }
        },
        {
          "type": "tile",
          "settings": {
            "kicker": "COLLECTION 02",
            "title": "New arrivals",
            "url": "/products"
          }
        },
        {
          "type": "tile",
          "settings": {
            "kicker": "COLLECTION 03",
            "title": "Most loved",
            "url": "/products"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Editorial tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Overline",
          "default": "COLLECTION"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The essentials"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/products"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description",
          "default": "Collection photo"
        }
      ]
    }
  ]
}
</schema>
