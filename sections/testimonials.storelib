            "author": "Priya Patel",
            "role": "Operations Lead",
            "company": "Velocity Co.",
            "rating": 5,
            "date": "March 2025",
            "verified": false,
            "source": "twitter"
          }
        }
      ]
    }
  ]
}
</schema>
