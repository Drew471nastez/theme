        },
        {
          "label": "Masonry",
          "value": "masonry"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white",
      "options": [
        {
          "label": "White",
          "value": "white"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Black",
          "value": "black"
        },
        {
          "label": "Highlight",
          "value": "highlight"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / star color",
      "default": "#f59e0b"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "id": "hdr_padding",
      "label": "Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product completely changed how I work. I can't imagine going back.",
          "placeholder": "Customer quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Jane Smith",
          "placeholder": "Full name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / title",
          "default": "Product Manager",
          "placeholder": "Job title"
        },
        {
          "type": "text",
          "id": "company",
          "label": "Company",
          "default": "Acme Corp",
          "placeholder": "Company name"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image",
          "default": ""
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating (1\u20135)",
          "default": 5,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "March 2025",
          "placeholder": "e.g. March 2025"
        },
        {
          "type": "toggle",
          "id": "verified",
          "label": "Verified badge",
          "default": true
        },
        {
          "type": "select",
          "id": "source",
          "label": "Review source",
          "default": "google",
          "options": [
            {
              "label": "Google",
              "value": "google"
            },
            {
              "label": "Trustpilot",
              "value": "trustpilot"
            },
            {
              "label": "Twitter / X",
              "value": "twitter"
            },
            {
              "label": "Facebook",
              "value": "facebook"
            },
            {
              "label": "Instagram",
              "value": "instagram"
            },
            {
              "label": "Yelp",
              "value": "yelp"
            },
            {
              "label": "Verified purchase",
              "value": "site"
            },
            {
              "label": "None",
              "value": "none"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Three testimonials carousel",
      "settings": {
        "heading": "What our customers say",
        "layout": "carousel",
        "show_rating": true,
        "show_date": true,
        "accent_color": "#f59e0b",
        "card_bg_color": "#ffffff",
        "bg_color": "#f9fafb",
        "text_color": "#111827",
        "padding_top": 60,
        "padding_bottom": 60
      },
      "blocks": [
        {
          "id": "t1",
          "type": "testimonial",
          "settings": {
            "quote": "Absolutely love this product. It saves me hours every week and the support team is fantastic!",
            "author": "Sarah Johnson",
            "role": "Freelance Designer",
            "company": "Self-employed",
            "rating": 5,
            "date": "January 2025",
            "verified": true,
            "source": "google"
          }
        },
        {
          "id": "t2",
          "type": "testimonial",
          "settings": {
            "quote": "Best purchase I've made this year. Setup was a breeze and results were immediate.",
            "author": "Marcus Lee",
            "role": "Head of Marketing",
            "company": "Bright Ideas Inc.",
            "rating": 5,
            "date": "February 2025",
            "verified": true,
            "source": "trustpilot"
          }
        },
        {
          "id": "t3",
          "type": "testimonial",
          "settings": {
