      "default": "Join thousands of happy customers who trust us every day.",
      "placeholder": "Supporting text"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "carousel",
      "options": [
        {
          "label": "Cards (grid)",
          "value": "card"
        },
        {
          "label": "Carousel",
