<template>
{# A window over the page after a few seconds: a sign-up, an offer, a notice.
   The page opens it (data-open) and remembers a visitor who closed it
   (components/website-builder/sections/overlay-hooks.ts). In the builder it
   is drawn open, in the page, so it can be seen and edited. #}
<div class="pop {% if page.in_editor %}pop--canvas{% endif %}" data-scheme="{{ settings.color_scheme }}" data-storelib-popup data-delay="{{ settings.delay }}" data-once="{% if settings.every_visit %}0{% else %}1{% endif %}"{% if page.in_editor %} data-open{% endif %} style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --pop-w: {{ settings.width }}px; --pop-dim: {{ settings.dim }};">
  <div class="pop__dim" data-storelib-popup-close></div>
  <div class="pop__card pop__card--{{ settings.position }}" role="dialog" aria-modal="false" aria-labelledby="pop-{{ section.id }}">
    <button class="pop__x" type="button" data-storelib-popup-close aria-label="{{ settings.close_label }}">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    {% if settings.image %}<img class="pop__img" src="{{ settings.image | asset }}" alt="" loading="lazy" decoding="async">{% endif %}
    <div class="pop__body">
      {% if settings.heading %}<h2 class="pop__h" id="pop-{{ section.id }}">{{ settings.heading }}</h2>{% endif %}
      {% if settings.text %}<p class="pop__text">{{ settings.text }}</p>{% endif %}
      {% if settings.content == 'email' %}
        {# Sign-ups go to Subscribers (lib/website-builder/form-intent.ts). #}
        <form class="pop__form" method="post" data-storelib-form="subscribe">
          <label class="pop__sr" for="pop-email-{{ section.id }}">{{ words.email_address }}</label>
          <input class="pop__input" id="pop-email-{{ section.id }}" type="email" name="email" placeholder="{{ settings.placeholder }}" required autocomplete="email">
          <button class="pop__btn" type="submit">{{ settings.button_text }}</button>
        </form>
      {% elsif settings.content == 'button' and settings.button_text %}
        <a class="pop__btn" href="{{ settings.button_url | default: '/products' | url }}">{{ settings.button_text }}</a>
      {% endif %}
      {% if settings.note %}<p class="pop__note">{{ settings.note }}</p>{% endif %}
    </div>
  </div>
</div>
</template>

<style scoped>
.pop { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 16px; visibility: hidden; pointer-events: none; }
.pop[data-open] { visibility: visible; pointer-events: auto; }
.pop__dim { position: absolute; inset: 0; background: rgba(0, 0, 0, var(--pop-dim)); opacity: 0; transition: opacity 220ms ease; }
.pop[data-open] .pop__dim { opacity: 1; }
.pop__card {
  position: relative; width: min(100%, var(--pop-w)); max-height: calc(100dvh - 32px); overflow: auto;
  background: var(--s-bg); color: var(--s-text); border-radius: var(--s-radius); box-shadow: 0 18px 50px rgba(0, 0, 0, 0.2);
  opacity: 0; transform: translateY(12px); transition: opacity 220ms ease, transform 220ms ease;
}
.pop[data-open] .pop__card { opacity: 1; transform: none; }
.pop:has(.pop__card--corner) { align-items: flex-end; justify-content: flex-end; }
.pop:has(.pop__card--corner) .pop__dim { display: none; }
.pop:has(.pop__card--corner)[data-open] { pointer-events: none; }
.pop__card--corner { pointer-events: auto; margin-bottom: max(var(--sl-bottom-bar-h, 0px), env(safe-area-inset-bottom, 0px)); }
.pop__x {
  position: absolute; top: 10px; right: 10px; z-index: 1; display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; padding: 0; border: 0; border-radius: 999px; background: var(--s-bg); color: var(--s-heading); cursor: pointer;
}
.pop__x:hover { background: var(--s-border); }
.pop__img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
.pop__body { padding: 28px; text-align: center; }
.pop__h {
  margin: 0; color: var(--s-heading);
  font-size: min(var(--section-heading-size, 26px), 28px); line-height: var(--section-heading-line-height, 1.2); font-weight: var(--section-heading-weight, 700);
  letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.pop__text { margin: 10px 0 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.55); color: var(--s-para); }
.pop__form { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.pop__input {
  flex: 1 1 180px; min-width: 0; padding: 12px 14px; font: inherit; font-size: 15px; color: var(--s-heading);
  background: transparent; border: 1px solid var(--s-border); border-radius: var(--s-radius);
}
.pop__input::placeholder { color: var(--s-para); opacity: 0.7; }
.pop__input:focus { outline: 2px solid var(--s-accent); outline-offset: 1px; }
.pop__btn {
  display: inline-flex; align-items: center; justify-content: center; flex: none; margin-top: 0;
  padding: var(--sl-button-padding, 12px 22px); font: inherit; font-size: var(--sl-button-size, 15px); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  background: var(--s-btn); color: var(--s-btn-text); border: 1px solid var(--s-btn); border-radius: var(--s-radius); cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.pop__body > .pop__btn { margin-top: 20px; }
.pop__btn:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.pop__note { margin: 14px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }
.pop__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
@media (prefers-reduced-motion: reduce) { .pop__dim, .pop__card { transition: none; transform: none; } }

/* In the builder: open, in the page, at the bottom of it. */
.pop--canvas { position: relative; inset: auto; min-height: 420px; padding: 32px 16px; }
.pop--canvas:has(.pop__card--corner) { padding: 32px 24px; }

/* Foundation baseline: content-width and mobile overflow guard. */
.s, .s__in { box-sizing: border-box; min-width: 0; }
.s__in { width: 100%; }
.s img, .s video, .s svg { max-width: 100%; }
.s button, .s input, .s select, .s textarea { max-width: 100%; }
.s :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .s *, .s *::before, .s *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "popup",
  "name": "Popup",
  "category": "overlay",
  "description": "A window that opens over the page after a few seconds, with an email sign-up or a button.",
  "version": "1.0.0",
  "icon": "message-square",
  "enabled_on": { "groups": ["overlay"] },
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "image_picker", "id": "image", "label": "Picture", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Leave your email and the code is on its way." },
    {
      "type": "radio", "id": "content", "label": "Below the text", "default": "email",
      "options": [ { "label": "Email sign-up", "value": "email" }, { "label": "A button", "value": "button" }, { "label": "Nothing", "value": "none" } ]
    },
    { "type": "text", "id": "placeholder", "label": "Email box says", "default": "you@example.com" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Send me the code" },
    { "type": "url", "id": "button_url", "label": "Button goes to", "default": "/products", "info": "Used when Below the text is A button." },
    { "type": "text", "id": "note", "label": "Small print", "default": "" },
    { "type": "text", "id": "close_label", "label": "Close button read aloud", "default": "Close" },
    { "type": "header", "id": "hdr_when", "label": "When it opens" },
    { "type": "range", "id": "delay", "label": "Opens after", "default": 5, "min": 0, "max": 60, "step": 1, "unit": "s" },
    { "type": "toggle", "id": "every_visit", "label": "Open on every visit", "default": false, "info": "Off, a visitor who closes it does not see it again." },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    {
      "type": "radio", "id": "position", "label": "Where", "default": "center",
      "options": [ { "label": "Middle of the screen", "value": "center" }, { "label": "Bottom corner", "value": "corner" } ]
    },
    { "type": "range", "id": "width", "label": "Width", "default": 440, "min": 300, "max": 720, "step": 20, "unit": "px" },
    { "type": "range", "id": "dim", "label": "Page dimmed", "default": 0.45, "min": 0, "max": 0.8, "step": 0.05 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Popup" }
  ]
}
</schema>
