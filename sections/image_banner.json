{
  "type": "image_banner",
  "name": "Image banner",
  "description": "Large image with optional text overlay and CTA",
  "supports_typography_overrides": false,
  "icon": "image",
  "category": "media",
  "fields": [
    {
      "id": "hdr_content",
      "label": "Content",
      "type": "header"
    },
    {
      "id": "image_url",
      "label": "Image",
      "type": "image"
    },
    {
      "id": "heading",
      "label": "Overlay heading",
      "type": "text",
      "placeholder": "New Season"
    },
    {
      "id": "subheading",
      "label": "Overlay subheading",
      "type": "text",
      "placeholder": "Explore the latest drops"
    },
    {
      "id": "hdr_button",
      "label": "Button",
      "type": "header"
    },
    {
      "id": "button_text",
      "label": "Button text",
      "type": "text",
      "placeholder": "Shop Now"
    },
    {
      "id": "button_url",
      "label": "Button URL",
      "type": "link"
    },
    {
      "id": "button_style",
      "label": "Button style",
      "type": "radio",
      "default": "filled",
      "options": [
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Ghost",
          "value": "ghost"
        }
      ]
    },
    {
      "id": "button_color",
      "label": "Button color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "button_text_color",
      "label": "Button text color",
      "type": "color",
      "default": "#0f172a"
    },
    {
      "id": "button_border_radius",
      "label": "Button radius",
      "type": "range",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "id": "hdr_style",
      "label": "Style",
      "type": "header"
    },
    {
      "id": "color_scheme",
      "label": "Color scheme",
      "type": "select",
      "default": "white",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Soft",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Brand",
          "value": "black"
        },
        {
          "label": "Accent",
          "value": "highlight"
        }
      ]
    },
    {
      "id": "overlay_color",
      "label": "Overlay color",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "id": "bg_color",
      "label": "Background",
      "type": "color",
      "default": "#111827",
      "info": "Shown behind the media, and on its own before an image is chosen."
    },
    {
      "id": "text_color",
      "label": "Text color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "font_size_heading",
      "label": "Heading font size",
      "type": "range",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "type": "select",
      "default": "16:9",
      "options": [
        {
          "label": "16:9 (Widescreen)",
          "value": "16:9"
        },
        {
          "label": "3:1 (Banner)",
          "value": "3:1"
        },
        {
          "label": "4:3 (Classic)",
          "value": "4:3"
        },
        {
          "label": "21:9 (Cinematic)",
          "value": "21:9"
        },
        {
          "label": "Auto",
          "value": "auto"
        }
      ]
    },
    {
      "id": "hdr_layout",
      "label": "Layout",
      "type": "header"
    },
    {
      "id": "alignment",
      "label": "Text alignment",
      "type": "radio",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "id": "max_width",
      "label": "Container width",
      "type": "select",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Wide banner with CTA",
      "settings": {
        "heading": "New Season, New Styles",
        "subheading": "Explore the latest collection",
        "button_text": "Shop Now",
        "button_url": "/products",
        "button_style": "filled",
        "overlay_color": "#000000",
        "overlay_opacity": 35,
        "text_color": "#ffffff",
        "aspect_ratio": "3:1",
        "alignment": "center",
        "padding_top": 0,
        "padding_bottom": 0,
        "color_scheme": "dark"
      }
    }
  ]
}
