  "custom_css": "/* Header. Sticky on scroll up, done by the browser: the header stays pinned, slides away while the visitor scrolls down and slides back as soon as they scroll up. Without browser support it simply stays pinned. */\n:root { --sl-hdr-ease: cubic-bezier(0.22, 1, 0.36, 1); }\n/* 0 near the top of the page, 1 once the page has scrolled past the header, so it never slides over the announcement bar. */\n@property --sl-hdr-away { syntax: '<number>'; inherits: true; initial-value: 0; }\n@keyframes sl-hdr-away { from { --sl-hdr-away: 0; } to { --sl-hdr-away: 1; } }\n@supports (container-type: scroll-state) and (animation-timeline: scroll()) {\n  html { container-type: scroll-state; container-name: sl-page; animation: sl-hdr-away linear both; animation-timeline: scroll(root); animation-range: 180px 181px; }\n  :is([data-section-id=\"header\"], header:not([data-section-id=\"header\"] *, main *, footer *)) { transition: translate 360ms var(--sl-hdr-ease), box-shadow 360ms var(--sl-hdr-ease); }\n  @container sl-page scroll-state(scrolled: bottom) {\n    :is([data-section-id=\"header\"], header:not([data-section-id=\"header\"] *, main *, footer *)) { translate: 0 calc((-100% - 12px) * var(--sl-hdr-away)); transition-duration: 280ms; }\n  }\n}\n/* Page to page. The header holds still, the old page steps out quickly and the new one settles in, with no double image. */\n@view-transition { navigation: auto; }\n:is([data-section-id=\"header\"], header:not([data-section-id=\"header\"] *, main *, footer *)) { view-transition-name: sl-header; }\n::view-transition-group(sl-header) { animation-duration: 300ms; animation-timing-function: var(--sl-hdr-ease); }\n::view-transition-old(sl-header) { animation: none; opacity: 0; }\n::view-transition-new(sl-header) { animation: none; }\n::view-transition-old(root) { animation: sl-page-out 140ms cubic-bezier(0.4, 0, 1, 1) both; }\n::view-transition-new(root) { animation: sl-page-in 260ms cubic-bezier(0, 0, 0.2, 1) 70ms both; }\n@keyframes sl-page-out { to { opacity: 0; } }\n@keyframes sl-page-in { from { opacity: 0; } }\n@media (prefers-reduced-motion: reduce) {\n  :is([data-section-id=\"header\"], header:not([data-section-id=\"header\"] *, main *, footer *)) { transition: none !important; }\n  ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }\n}",
